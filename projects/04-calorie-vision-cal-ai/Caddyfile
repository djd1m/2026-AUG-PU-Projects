# Единственная дверь стека (профиль `edge`).
#
# Что эта дверь НЕ делает и почему это записано, а не подразумевается:
#
# 1. НЕ ставит CORS-заголовков. `web` и `api` живут на ОДНОМ origin, а два одинаковых
#    заголовка ломают CORS молча, и `curl` этого не показывает — он политику браузера не
#    применяет (`deployment-seams.md`).
# 2. НЕ ставит Content-Security-Policy. CSP ставит РОВНО ОДНО место — `apps/web/middleware.ts`,
#    потому что политика обязана нести nonce, известный только тому, кто отрисовал страницу.
#    Заголовок, поставленный здесь ВТОРЫМ, дал бы браузеру пересечение двух политик и
#    сломал бы страницу тем же молчаливым способом, что и двойной CORS.
# 3. ОГРАНИЧИВАЕТ ЧАСТОТУ — и это ДВЕ РАЗНЫЕ защиты, а не дубль. Приложенческий ограничитель
#    (`apps/api/src/http/rate-limit.ts`) покрывает только `api` и работает ДО разбора тела;
#    здесь ограничивается ВЕСЬ трафик двери, включая `web` и статику, до того как запрос
#    вообще войдёт в сеть compose. Модуля нет в стандартном образе, поэтому дверь собирается
#    из `proxy/Dockerfile` (`xcaddy` + `caddy-ratelimit`), а сборка ПРОВЕРЯЕТ наличие модуля:
#    «собралось» и «ограничение работает» — разные утверждения.

{
	# Стенд слушает по HTTP на петле; TLS терминирует вышестоящий reverse-proxy машины.
	auto_https off
	# Директива стороннего модуля не входит в стандартный порядок — порядок задаётся явно,
	# и задаётся ПЕРВЫМ: ограничение частоты, срабатывающее после проксирования, не защищает
	# ничего.
	order rate_limit before basicauth
	# Административный API остаётся на 127.0.0.1:2019 внутри контейнера — он и есть проба
	# здоровья из compose. Наружу не публикуется.
}

:80 {
	# ДВА порога, а не один: канон §7 (DEC-A-013) различает мутации и чтение — 30 и 120
	# запросов в минуту на адрес. Один общий порог либо душит чтение страницы со статикой,
	# либо оставляет мутации на уровне чтения; и то и другое — не тот предел, что объявлен.
	#
	# Пороги приходят из окружения и НЕ имеют значения по умолчанию: незаданная переменная
	# валит загрузку конфигурации, то есть дверь не поднимается вовсе. Предел, которого нет,
	# — это отсутствие предела, а не «по умолчанию разумно».
	#
	# Ключ — {remote_host}, адрес непосредственного клиента двери. Заголовкам клиента здесь
	# доверия нет: дверь на то и дверь, что перед ней ничего нашего не стоит.
	@mutations not method GET HEAD OPTIONS
	rate_limit @mutations {
		zone door_mutate {
			key {remote_host}
			events {$N4_PROXY_RATE_MUTATE_PER_MIN}
			window 1m
		}
	}

	@reads method GET HEAD OPTIONS
	rate_limit @reads {
		zone door_read {
			key {remote_host}
			events {$N4_PROXY_RATE_READ_PER_MIN}
			window 1m
		}
	}

	encode gzip

	# Публичная карточка не кэшируется НИКЕМ: отзыв согласия обязан закрыть уже
	# опубликованный адрес за 60 секунд, а кэш сделал бы этот срок недостижимым.
	@card path /c/*
	header @card Cache-Control "no-store"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}

	# Продуктовые маршруты канона и служебная проба здоровья — в `api`.
	handle /api/* {
		reverse_proxy api:3000
	}
	handle /health {
		reverse_proxy api:3000
	}

	# Всё остальное — фронт. Caddy дописывает адрес клиента в КОНЕЦ X-Forwarded-For,
	# и именно последний элемент читает `api`: он поставлен НАШИМ прокси.
	handle {
		reverse_proxy web:3000
	}
}
