    ...overrides,
    // @ts-expect-error — служебное поле для чтения из тестов, не часть контракта деп.
    __recorded: recorded,
  };
}

function recordedOf(deps: RecognizeScanDeps): Array<{ target: { id: string; fence: number }; record: ResultRecord }> {
