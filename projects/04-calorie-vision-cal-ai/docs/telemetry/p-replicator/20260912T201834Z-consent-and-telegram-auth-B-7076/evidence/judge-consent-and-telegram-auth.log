// Атомарный модуль потолков (FR-foundation-5, `CheckAndConsumeQuota`).
//
// Ядро, на которое опираются все следующие фичи. Здесь модель не вызывается — её в этой
// фиче нет вовсе; здесь только решение «можно» или «отказ с названным scope».
//
// ОДИН оператор на ключ. «Прочитать, потом записать» ЗАПРЕЩЕНО: две попытки приходят
// ОДНОВРЕМЕННО, обе читают `used = 9`, обе пишут `10` — и одиннадцатый скан проходит.
// Последовательный тест зеленеет при обеих реализациях; различает их только конкурентный
// прогон (`shared-resource-verification`).
//
// Все ключи ОДНОЙ попытки — в ОДНОЙ транзакции. Отказ по любому ключу откатывает её
// целиком, а не декрементирует встречными операторами: параллельная попытка, попавшая
// между инкрементом и декрементом, увидела бы завышенное значение и получила бы отказ
// незаслуженно (`CheckAndConsumeQuota` шаг 4).

import { withTransaction, type DbPool } from '@n4/db';
import type { QuotaLimits, QuotaScope } from '@n4/shared';
import { moscowDay, quotaKeys, type QuotaReason } from './keys.js';

export interface QuotaInput {
  readonly sessionId: string;
  readonly ipPrefix: string;
  readonly reason: QuotaReason;
  readonly limits: QuotaLimits;
  /** Момент, от которого берутся московские сутки. Подменяется только тестом. */
  readonly at?: Date;
}

export type QuotaDecision =
  | { readonly outcome: 'granted'; readonly day: string }
  | { readonly outcome: 'refused'; readonly day: string; readonly scope: QuotaScope };

/** Внутренний сигнал отката. Наружу не выходит: он превращается в `refused(scope)`. */
class QuotaExhausted extends Error {
  readonly scope: QuotaScope;
  constructor(scope: QuotaScope) {
    super(`потолок ${scope} достигнут`);
    this.name = 'QuotaExhausted';
    this.scope = scope;
  }
}

const CONSUME_SQL = `
  INSERT INTO scan_quota_counter (scope, scope_key, day, used, "limit")
  VALUES ($1, $2, $3, 1, $4)
  ON CONFLICT (scope, scope_key, day) DO UPDATE
    SET used = scan_quota_counter.used + 1
    WHERE scan_quota_counter.used < $4
  RETURNING used
`;

export async function checkAndConsumeQuota(pool: DbPool, input: QuotaInput): Promise<QuotaDecision> {
  const day = moscowDay(input.at);
  // Порядок ключей ОДИНАКОВ у всех вызывающих (сессия → адрес → global → escalation).
  // Это не косметика: транзакция держит блокировки строк до конца, и два вызова, берущие
  // одни и те же строки в РАЗНОМ порядке, дают взаимную блокировку под конкуренцией.
  const keys = quotaKeys(input.reason, input.sessionId, input.ipPrefix, input.limits);

  try {
    await withTransaction(pool, async (client) => {
      for (const key of keys) {
        const result = await client.query(CONSUME_SQL, [key.scope, key.scopeKey, day, key.limit]);
        // ПУСТОЙ результат И ЕСТЬ «предел достигнут»: строка существует, но условие
        // `used < limit` не выполнилось, поэтому UPDATE не тронул ни одной строки.
        if (result.rowCount === 0) throw new QuotaExhausted(key.scope);
      }
    });
  } catch (error) {
    if (error instanceof QuotaExhausted) return { outcome: 'refused', day, scope: error.scope };
    // Любая другая ошибка — отказ базы, и он обязан быть ИСКЛЮЧЕНИЕМ, а не значением:
    // штатный возврат из транзакции закоммитил бы то, что успело записаться до неё.
    throw error;
  }

  return { outcome: 'granted', day };
}
// Живой поставщик. В фиче `foundation` он НЕ реализован, и это состояние, а не пропуск:
// ключа на машине нет (DEC-A-009), а «реализация», которую нечем проверить, была бы
// обещанием. Заглушка бросает исключение с названной причиной — тихо вернуть пустой
// ответ нельзя: он был бы неотличим от успешного разбора пустой тарелки.

import type { ModelProvider, ModelRequest, ModelResponse } from './types.js';

export class LiveProviderNotImplemented extends Error {
  constructor() {
    super('живой поставщик модели не реализован в фиче foundation: вызовы наружу вводит фича scan-pipeline');
    this.name = 'LiveProviderNotImplemented';
  }
}

export function createLiveModelProvider(_apiKey: string): ModelProvider {
  return {
    kind: 'live',
    async recognize(_request: ModelRequest): Promise<ModelResponse> {
      throw new LiveProviderNotImplemented();
    },
  };
}
# N4 «Тарелка» — скелет стека. Код ещё не написан: сервисы api/recognizer/web НЕ соберутся,
# пока фича `foundation` не создаст package.json монорепо и исходники. Поэтому они собраны в
# профиль `app` — без него поднимаются только db и storage, и файл остаётся проверяемым
# (`docker compose config`) до появления кода.
#
# Перед ЛЮБЫМ `docker compose up`:
#   node ../../.claude/hooks/check-ports.cjs .          # что смотрит наружу (Правило №0)
#   bash ../../scripts/check-port-conflicts.sh .        # свободно ли то, что мы просим
# Две проверки, а не одна: это разные вопросы, и ни одна не заменяет другую.
name: ${N4_COMPOSE_PROJECT:-n4-tarelka}

services:

  # ─── Данные. Публикации на хост нет вовсе: соседи по сети compose ходят по имени db:5432 ───
  db:
    image: postgres:16.15-alpine@sha256:cf78e76683b9ca8c5733cbbdce6c9262b45b6767934dd0a95e671f9a0fc20685
    restart: unless-stopped
    environment:
      POSTGRES_USER: n4_admin
      POSTGRES_DB: n4
      POSTGRES_PASSWORD: ${N4_DB_ADMIN_PASSWORD:?задайте пароль администратора БД — пустое значение не означает «без пароля»}
      # Пароль роли приложения нужен БУТСТРАПУ кластера: роль — объект кластера, и её
      # пароль не имеет права лежать в SQL-файле, который коммитится (фича foundation).
      N4_DB_APP_PASSWORD: ${N4_DB_APP_PASSWORD:?задайте пароль роли приложения}
      TZ: Europe/Moscow
    # expose — документирующая запись; доступ внутри сети есть и без неё. Публикации нет.
    expose: ["5432"]
    volumes:
      - db-data:/var/lib/postgresql/data
      # Роли n4_migrate и n4_app создаются ОДИН раз при первой инициализации тома.
      # Таблицы создаёт миграция 001 из-под n4_migrate — это уже объекты схемы.
      - ./scripts/init-foundation-db.sh:/docker-entrypoint-initdb.d/10-init-foundation-db.sh:ro
    networks: [private]
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U n4_admin -d n4"]
      interval: 2s
      timeout: 2s
      retries: 30

  # ─── Приватный бакет фото. Портов не публикует; консоль наружу не выставляется ───
  storage:
    image: minio/minio:RELEASE.2025-04-22T22-12-26Z@sha256:a1ea29fa28355559ef137d71fc570e508a214ec84ff8083e39bc5428980b015e
    restart: unless-stopped
    command: server /data --console-address ":9001"
    environment:
      MINIO_ROOT_USER: ${N4_STORAGE_ROOT_USER:?задайте пользователя MinIO — minioadmin это готовая точка входа, а не «временно для тестов»}
      MINIO_ROOT_PASSWORD: ${N4_STORAGE_ROOT_PASSWORD:?задайте пароль MinIO — значение по умолчанию запрещено}
      TZ: Europe/Moscow
    expose: ["9000", "9001"]
    volumes:
      - storage-data:/data
    networks: [private]
    healthcheck:
      test: ["CMD", "mc", "ready", "local"]
      interval: 5s
      timeout: 3s
      retries: 20

  # ─── API: 13 маршрутов канона, приём и нормализация фото, квоты, initData ───
  api:
    build:
      context: .
      target: api
    # `edge` в списке — не украшение: proxy зависит от api и web, и профиль `edge`
    # БЕЗ них не поднимается вовсе («depends on undefined service»). Найдено первым
    # настоящим запуском профиля edge.
    profiles: [app, dev, edge]
    restart: unless-stopped
    environment:
      NODE_ENV: production
      TZ: Europe/Moscow
      # Дефолта нет намеренно: APP_ORIGIN определяет КАЖДУЮ выдаваемую наружу ссылку,
      # и тихий localhost сделал бы все выданные адреса нерабочими при зелёных тестах.
      APP_ORIGIN: ${APP_ORIGIN:?внешний адрес обязателен — он определяет каждую выдаваемую ссылку}
      # Роль n4_app создаётся миграцией 001 (фича foundation), а не этим файлом.
      DATABASE_URL: postgresql://n4_app:${N4_DB_APP_PASSWORD:?задайте пароль роли приложения}@db:5432/n4
      S3_ENDPOINT: http://storage:9000
      S3_BUCKET: ${N4_S3_BUCKET:-n4-photos}
      S3_ACCESS_KEY: ${N4_S3_ACCESS_KEY:?задайте ключ доступа приложения к бакету}
      S3_SECRET_KEY: ${N4_S3_SECRET_KEY:?задайте секрет доступа приложения к бакету}
      # Токен бота — только здесь: из него производится секрет HMAC для проверки initData.
      TELEGRAM_BOT_TOKEN: ${TELEGRAM_BOT_TOKEN:?токен бота обязателен — без него вход через Mini App неисполним}
      # ТРИ потолка. Отсутствие ЛЮБОГО обязано валить старт процесса (ADR-007): проверка
      # одной переменной зеленеет при отсутствующей второй, поэтому объявлены все три.
      N4_SCAN_LIMIT_USER: ${N4_SCAN_LIMIT_USER:?потолок на пользователя не задан — пустое значение не означает «без ограничений»}
      N4_SCAN_LIMIT_DAY: ${N4_SCAN_LIMIT_DAY:?суточный потолок попыток не задан}
      N4_ESCALATION_LIMIT_DAY: ${N4_ESCALATION_LIMIT_DAY:?суточный потолок эскалаций не задан}
      # Пороги ограничения частоты — числа канона §7 (DEC-A-013): 30 мутаций и 120 чтений
      # в минуту на один ip_prefix. Отсутствие валит старт наравне с потолками: предел,
      # которого нет, — это отсутствие предела, а не «по умолчанию разумно».
      N4_RATE_LIMIT_MUTATE_PER_MIN: ${N4_RATE_LIMIT_MUTATE_PER_MIN:?порог частоты для мутирующих маршрутов не задан}
      N4_RATE_LIMIT_READ_PER_MIN: ${N4_RATE_LIMIT_READ_PER_MIN:?порог частоты для чтения не задан}
    expose: ["3000"]
    networks: [private, egress]
    depends_on:
      db: { condition: service_healthy }
      storage: { condition: service_healthy }
    healthcheck:
