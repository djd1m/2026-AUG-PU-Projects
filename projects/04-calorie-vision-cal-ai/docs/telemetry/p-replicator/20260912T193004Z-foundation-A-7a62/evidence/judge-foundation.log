FILE scripts/check-env-wiring.sh
19: set -uo pipefail
20: FAIL=0
28: ALLOWED="${ENV_WIRING_ALLOWED:-NODE_ENV|TZ|PORT|CI|NEXT_TELEMETRY_DISABLED|NEXT_PUBLIC_[A-Z0-9_]*}"
30: PROJECT_DIR="${1:-.}"
31: cd "$PROJECT_DIR" || { echo "❌ каталог $PROJECT_DIR недоступен — проверка НЕ выполнена" >&2; exit 2; }
36: CONFIG="${ENV_WIRING_CONFIG-}"
37: if [ -z "${ENV_WIRING_CONFIG+set}" ] && ! command -v docker >/dev/null 2>&1; then
38:   echo '❌ docker недоступен — проверка НЕ выполнена' >&2
39:   exit 2
40: fi
42: if [ -z "${ENV_WIRING_CONFIG+set}" ]; then
47:   CONFIG=$(docker compose --profile app --profile edge --profile test config 2>/dev/null) || CONFIG=""
48: fi
49: if [ -z "$CONFIG" ]; then
50:   echo '❌ docker compose config нечитаем или пуст — проверка НЕ выполнена' >&2
51:   exit 2
52: fi
63: service_sources() {
64:   case "$1" in
65:     api)        echo 'apps/api' ;;
66:     recognizer) echo 'apps/recognizer' ;;
67:     web)        echo 'apps/web' ;;
69:   esac
70: }
72: echo '== Переменные, читаемые кодом, доезжают до сервиса =='
74: for svc in api recognizer web; do
75:   dirs=$(service_sources "$svc")
76:   [ -z "$dirs" ] && continue
77:   [ -d "$dirs" ] || { echo "  ⚠️  $svc: каталог $dirs отсутствует — пропуск"; continue; }
91:   used=$(find "$dirs" -type d \( -name node_modules -o -name .next -o -name dist \) -prune -o \
92:            -type f \( -name '*.ts' -o -name '*.tsx' -o -name '*.js' -o -name '*.mjs' \) -print 2>/dev/null \
93:          | xargs -r cat 2>/dev/null \
94:          | grep -vE '^[[:space:]]*(//|\*|/\*)' \
95:          | grep -oE "(^|[^A-Za-z0-9_])env\.[A-Z][A-Z0-9_]*|(^|[^A-Za-z0-9_])env\[['\"][A-Z][A-Z0-9_]*" \
96:          | grep -oE '[A-Z][A-Z0-9_]*$' | sort -u)
97:   if [ -z "$used" ]; then
98:     echo "  ⚠️  $svc: ни одной переменной не читается — проверять нечего"
99:     continue
100:   fi
111:   passed=$(printf '%s\n' "$CONFIG" \
112:            | awk -v svc="  $svc:" '
113:                $0 == svc { inside = 1; inenv = 0; next }
114:                /^  [a-zA-Z0-9_-]+:$/ { inside = 0; inenv = 0; next }
115:                !inside { next }
116:                /^    [a-zA-Z0-9_.-]+:/ { inenv = ($0 ~ /^    environment:[[:space:]]*$/) ? 1 : 0; next }
117:                inenv { print }
118:              ' \
119:            | grep -oE '^[[:space:]]+[A-Z][A-Z0-9_]*:' | tr -d ' :' | sort -u)
122:   if ! printf '%s\n' "$CONFIG" | grep -qxE "  $svc:"; then
123:     echo "❌ сервис $svc отсутствует в docker compose config — проверка НЕ выполнена" >&2
124:     exit 2
125:   fi
127:   missing=$(comm -23 <(echo "$used") <(echo "$passed") | grep -vxE "$ALLOWED" || true)
129:   if [ -n "$missing" ]; then
130:     while read -r v; do
131:       [ -n "$v" ] && { printf '  ❌ %s: %s читается кодом, но не передаётся сервису\n' "$svc" "$v"; FAIL=1; }
132:     done <<<"$missing"
133:   else
134:     printf '  ✅ %s: все читаемые переменные проброшены\n' "$svc"
135:   fi
136: done
138: if [ "$FAIL" -ne 0 ]; then
139:   echo
140:   echo '     Добавить в environment соответствующего сервиса docker-compose.yml.'
141:   echo '     Приложение стартует и без них — ошибка видна только в поведении.'
142: fi
143: exit $FAIL

