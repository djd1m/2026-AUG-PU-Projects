62: ): Promise<SessionOutcome> {
63:   if (input.presentedToken !== undefined && input.presentedToken.trim() !== '') {
64:     const existing = await executor.query<DeviceSessionRow>(SELECT_BY_HASH, [hashSessionToken(input.presentedToken)]);
65:     const row = existing.rows[0];
66:     if (row !== undefined) return { session: row, created: false };
68:   }
