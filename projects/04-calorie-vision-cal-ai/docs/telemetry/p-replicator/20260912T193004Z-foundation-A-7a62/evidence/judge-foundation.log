FILE Caddyfile
19: {
21: 	auto_https off
25: 	order rate_limit before basicauth
28: }
30: :80 {
41: 	@mutations not method GET HEAD OPTIONS
42: 	rate_limit @mutations {
43: 		zone door_mutate {
44: 			key {remote_host}
45: 			events {$N4_PROXY_RATE_MUTATE_PER_MIN}
46: 			window 1m
47: 		}
48: 	}
50: 	@reads method GET HEAD OPTIONS
51: 	rate_limit @reads {
52: 		zone door_read {
53: 			key {remote_host}
54: 			events {$N4_PROXY_RATE_READ_PER_MIN}
55: 			window 1m
56: 		}
57: 	}
59: 	encode gzip
63: 	@card path /c/*
64: 	header @card Cache-Control "no-store"
66: 	header {
67: 		X-Content-Type-Options nosniff
68: 		Referrer-Policy strict-origin-when-cross-origin
69: 		X-Frame-Options SAMEORIGIN
70: 		-Server
71: 	}
74: 	handle /api/* {
75: 		reverse_proxy api:3000
76: 	}
77: 	handle /health {
78: 		reverse_proxy api:3000
79: 	}
83: 	handle {
84: 		reverse_proxy web:3000
85: 	}
86: }

