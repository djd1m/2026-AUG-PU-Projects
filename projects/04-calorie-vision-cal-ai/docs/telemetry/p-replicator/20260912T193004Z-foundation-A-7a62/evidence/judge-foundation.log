57:   const keys = quotaKeys(input.reason, input.sessionId, input.ipPrefix, input.limits);
59:   try {
60:     await withTransaction(pool, async (client) => {
61:       for (const key of keys) {
62:         const result = await client.query(CONSUME_SQL, [key.scope, key.scopeKey, day, key.limit]);
65:         if (result.rowCount === 0) throw new QuotaExhausted(key.scope);
66:       }
67:     });
68:   } catch (error) {
69:     if (error instanceof QuotaExhausted) return { outcome: 'refused', day, scope: error.scope };
72:     throw error;
73:   }
75:   return { outcome: 'granted', day };
76: }

