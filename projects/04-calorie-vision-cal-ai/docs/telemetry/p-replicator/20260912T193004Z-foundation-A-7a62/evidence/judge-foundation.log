/bin/bash -lc "git diff ec0d2b0603d6bc820b892d001faba9e39bd01138..HEAD -- apps packages scripts Caddyfile Dockerfile docker-compose.yml ':"'!scripts/run-judge.sh'"' | sed '/"'^+'"\\/\\//d; /"'^+--/d; /''^+#/d; /''^+$/d'"';" in /home/dz-projects-2026/2026-AUG-PU-Projects/2026-AUG-PU-Projects/projects/04-calorie-vision-cal-ai
 succeeded in 0ms:
diff --git a/projects/04-calorie-vision-cal-ai/Caddyfile b/projects/04-calorie-vision-cal-ai/Caddyfile
new file mode 100644
index 0000000..41450f5
--- /dev/null
+++ b/projects/04-calorie-vision-cal-ai/Caddyfile
@@ -0,0 +1,53 @@
+{
+	# Стенд слушает по HTTP на петле; TLS терминирует вышестоящий reverse-proxy машины.
+	auto_https off
+	# Административный API остаётся на 127.0.0.1:2019 внутри контейнера — он и есть проба
+	# здоровья из compose. Наружу не публикуется.
+}
+:80 {
+	encode gzip
+	# Публичная карточка не кэшируется НИКЕМ: отзыв согласия обязан закрыть уже
+	# опубликованный адрес за 60 секунд, а кэш сделал бы этот срок недостижимым.
+	@card path /c/*
+	header @card Cache-Control "no-store"
+	header {
+		X-Content-Type-Options nosniff
+		Referrer-Policy strict-origin-when-cross-origin
+		X-Frame-Options SAMEORIGIN
+		-Server
+	}
+	# Продуктовые маршруты канона и служебная проба здоровья — в `api`.
+	handle /api/* {
+		reverse_proxy api:3000
+	}
+	handle /health {
+		reverse_proxy api:3000
+	}
+	# Всё остальное — фронт. Caddy дописывает адрес клиента в КОНЕЦ X-Forwarded-For,
+	# и именно последний элемент читает `api`: он поставлен НАШИМ прокси.
+	handle {
+		reverse_proxy web:3000
+	}
+}
diff --git a/projects/04-calorie-vision-cal-ai/Dockerfile b/projects/04-calorie-vision-cal-ai/Dockerfile
index 56c2c12..5fdd9c8 100644
