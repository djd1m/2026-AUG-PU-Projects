18: : "${POSTGRES_DB:?POSTGRES_DB обязателен}"
19: : "${N4_DB_APP_PASSWORD:?N4_DB_APP_PASSWORD обязателен: без него роль приложения не создаётся, и пустое значение не означает «без пароля»}"
21: if [[ "$POSTGRES_USER" != n4_admin || "$POSTGRES_DB" != n4 ]]; then
22:   echo 'бутстрап N4 требует своей базы n4 и администратора n4_admin' >&2
23:   exit 1
24: fi
25: if [[ "${N4_DB_ADMIN_PASSWORD:-}" == "$N4_DB_APP_PASSWORD" ]]; then
26:   echo 'пароль администратора и пароль роли приложения обязаны различаться' >&2
27:   exit 1
28: fi
30: psql --username "$POSTGRES_USER" --dbname "$POSTGRES_DB" --set ON_ERROR_STOP=1 \
31:      --set app_password="$N4_DB_APP_PASSWORD" <<'SQL'
32: BEGIN;
34: -- Владелец схемы. NOLOGIN: снаружи под ним не подключаются, в него ВХОДЯТ через SET ROLE.
35: CREATE ROLE n4_migrate NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOBYPASSRLS;
37: -- Роль приложения: DML и только DML. Права на таблицы выдаёт миграция 001.
38: CREATE ROLE n4_app LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOBYPASSRLS PASSWORD :'app_password';
40: -- Членство: n4_admin имеет право стать n4_migrate. Без него SET ROLE в раннере откажет.
41: GRANT n4_migrate TO n4_admin;
43: REVOKE ALL ON DATABASE n4 FROM PUBLIC;
44: GRANT CONNECT ON DATABASE n4 TO n4_app, n4_migrate;
45: GRANT CREATE, TEMPORARY ON DATABASE n4 TO n4_migrate;
47: -- Схема public принадлежит владельцу схемы, а не всем подряд.
48: ALTER SCHEMA public OWNER TO n4_migrate;
49: REVOKE ALL ON SCHEMA public FROM PUBLIC;
50: GRANT USAGE ON SCHEMA public TO n4_app;
52: -- Запрос приложения не имеет права ждать блокировку вечно.
53: ALTER ROLE n4_app SET lock_timeout = '2s';
54: ALTER ROLE n4_app SET statement_timeout = '10s';
56: COMMIT;
57: SQL
59: echo 'роли n4_migrate и n4_app созданы'

