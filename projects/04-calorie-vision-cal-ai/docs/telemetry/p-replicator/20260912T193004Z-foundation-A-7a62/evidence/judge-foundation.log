+  /** Таймзона календарных суток, границ дня, стрика и суточных потолков. */
+  timezone: 'Europe/Moscow',
+  /** Срок жизни анонимного дневника, суток. */
+  anonymousDiaryDays: 7,
+  /** Срок хранения фото, суток. */
