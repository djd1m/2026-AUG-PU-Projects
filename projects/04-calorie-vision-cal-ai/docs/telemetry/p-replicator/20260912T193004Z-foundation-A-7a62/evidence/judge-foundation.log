28:   readonly session: DeviceSessionRow;
30:   readonly issuedToken?: string;
31:   readonly created: boolean;
32: }
34: export function hashSessionToken(token: string): string {
35:   return createHash('sha256').update(token, 'utf8').digest('hex');
36: }
38: export function generateSessionToken(): string {
39:   return randomBytes(TOKEN_BYTES).toString('base64url');
40: }
42: const SELECT_BY_HASH = `
43:   UPDATE device_session SET last_seen_at = now()
44:   WHERE cookie_token_hash = $1
45:   RETURNING id, created_at, last_seen_at, ip_prefix, account_id, anonymous_diary_expires_at
46: `;
48: const INSERT_SESSION = `
49:   INSERT INTO device_session (cookie_token_hash, ip_prefix, anonymous_diary_expires_at)
50:   VALUES ($1, $2, now() + ($3 || ' days')::interval)
51:   RETURNING id, created_at, last_seen_at, ip_prefix, account_id, anonymous_diary_expires_at
52: `;
59: export async function createOrReuseDeviceSession(
60:   executor: DbPool | DbClient,
61:   input: { readonly presentedToken: string | undefined; readonly ipPrefix: string },
62: ): Promise<SessionOutcome> {
63:   if (input.presentedToken !== undefined && input.presentedToken.trim() !== '') {
64:     const existing = await executor.query<DeviceSessionRow>(SELECT_BY_HASH, [hashSessionToken(input.presentedToken)]);
65:     const row = existing.rows[0];
66:     if (row !== undefined) return { session: row, created: false };
68:   }
70:   const token = generateSessionToken();
71:   const created = await executor.query<DeviceSessionRow>(INSERT_SESSION, [
72:     hashSessionToken(token),
73:     input.ipPrefix,
74:     String(CANON.anonymousDiaryDays),
75:   ]);
76:   const row = created.rows[0];
77:   if (row === undefined) throw new Error('сессия не создана: вставка не вернула строку');
78:   return { session: row, issuedToken: token, created: true };
79: }

FILE apps/api/src/http/rate-limit.ts
13: import type { FastifyInstance, FastifyReply, FastifyRequest } from 'fastify';
14: import { fail, type RateLimits } from '@n4/shared';
16: const WINDOW_MS = 60_000;
18: export interface RateLimiter {
20:   consume(key: string, bucket: 'mutate' | 'read', now?: number): { allowed: boolean; limit: number; remaining: number; resetAt: number };
21:   size(): number;
22: }
24: interface Counter {
25:   count: number;
26:   windowStart: number;
27: }
33: export function createRateLimiter(limits: RateLimits): RateLimiter {
34:   const counters = new Map<string, Counter>();
36:   const prune = (now: number): void => {
37:     if (counters.size < 10_000) return;
38:     for (const [key, counter] of counters) {
39:       if (now - counter.windowStart >= WINDOW_MS) counters.delete(key);
40:     }
41:   };
43:   return {
44:     consume(key, bucket, now = Date.now()) {
45:       const limit = bucket === 'mutate' ? limits.mutatePerMinute : limits.readPerMinute;
46:       const mapKey = `${bucket}:${key}`;
47:       const existing = counters.get(mapKey);
48:       if (existing === undefined || now - existing.windowStart >= WINDOW_MS) {
49:         prune(now);
50:         counters.set(mapKey, { count: 1, windowStart: now });
51:         return { allowed: true, limit, remaining: limit - 1, resetAt: now + WINDOW_MS };
52:       }
53:       existing.count += 1;
54:       const resetAt = existing.windowStart + WINDOW_MS;
55:       if (existing.count > limit) return { allowed: false, limit, remaining: 0, resetAt };
56:       return { allowed: true, limit, remaining: limit - existing.count, resetAt };
57:     },
58:     size() {
59:       return counters.size;
60:     },
61:   };
62: }
65: export function bucketFor(method: string): 'mutate' | 'read' {
66:   return method === 'GET' || method === 'HEAD' || method === 'OPTIONS' ? 'read' : 'mutate';
67: }
69: export function registerRateLimit(
70:   app: FastifyInstance,
71:   limiter: RateLimiter,
72:   keyOf: (request: FastifyRequest) => string,
73: ): void {
74:   app.addHook('onRequest', async (request: FastifyRequest, reply: FastifyReply) => {
75:     const decision = limiter.consume(keyOf(request), bucketFor(request.method));
76:     reply.header('RateLimit-Limit', String(decision.limit));
77:     reply.header('RateLimit-Remaining', String(decision.remaining));
78:     if (decision.allowed) return;
79:     reply.header('Retry-After', String(Math.max(1, Math.ceil((decision.resetAt - Date.now()) / 1000))));
82:     await reply.code(429).send(fail('rate_limited', 'слишком много запросов с этого адреса, попробуйте через минуту'));
83:   });
84: }

