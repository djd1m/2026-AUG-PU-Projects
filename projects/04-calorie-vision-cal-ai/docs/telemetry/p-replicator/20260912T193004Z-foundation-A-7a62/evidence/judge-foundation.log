8: import pg from 'pg';
10: export type DbPool = pg.Pool;
11: export type DbClient = pg.PoolClient;
13: export interface PoolOptions {
14:   readonly databaseUrl: string;
15:   readonly applicationName: string;
16:   readonly max?: number;
17:   readonly connectionTimeoutMillis?: number;
18:   readonly statementTimeoutMillis?: number;
19: }
21: export function createPool(options: PoolOptions): DbPool {
22:   if (!options.databaseUrl || options.databaseUrl.trim() === '') {
23:     throw new Error('DATABASE_URL не задан: пул соединений не создаётся');
24:   }
25:   return new pg.Pool({
26:     connectionString: options.databaseUrl,
27:     application_name: options.applicationName,
28:     max: options.max ?? 10,
29:     connectionTimeoutMillis: options.connectionTimeoutMillis ?? 5_000,
30:     idleTimeoutMillis: 30_000,
31:     statement_timeout: options.statementTimeoutMillis ?? 10_000,
32:   });
33: }
35: /**
40: export async function withTransaction<T>(pool: DbPool, work: (client: DbClient) => Promise<T>): Promise<T> {
41:   const client = await pool.connect();
42:   try {
43:     await client.query('BEGIN');
44:     let value: T;
45:     try {
46:       value = await work(client);
47:     } catch (error) {
48:       await client.query('ROLLBACK');
49:       throw error;
50:     }
51:     await client.query('COMMIT');
52:     return value;
53:   } finally {
54:     client.release();
55:   }
56: }

