43: const CONSUME_SQL = `
44:   INSERT INTO scan_quota_counter (scope, scope_key, day, used, "limit")
45:   VALUES ($1, $2, $3, 1, $4)
46:   ON CONFLICT (scope, scope_key, day) DO UPDATE
47:     SET used = scan_quota_counter.used + 1
48:     WHERE scan_quota_counter.used < $4
49:   RETURNING used
50: `;
52: export async function checkAndConsumeQuota(pool: DbPool, input: QuotaInput): Promise<QuotaDecision> {
