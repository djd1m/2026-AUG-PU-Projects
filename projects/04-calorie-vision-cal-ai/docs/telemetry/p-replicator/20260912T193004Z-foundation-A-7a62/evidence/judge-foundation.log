     expose: ["3000"]
     networks: [private, egress]
     depends_on:
       db: { condition: service_healthy }
       storage: { condition: service_healthy }
     healthcheck:
-      # Проверяется, что процесс СЛУШАЕТ. Это не готовность: канон объявляет ровно 13 маршрутов,
-      # и служебная ручка здоровья была бы четырнадцатым — она вводится решением по канону,
