31: cd "$PROJECT_DIR" || { echo "❌ каталог $PROJECT_DIR недоступен — проверка НЕ выполнена" >&2; exit 2; }
36: CONFIG="${ENV_WIRING_CONFIG-}"
37: if [ -z "${ENV_WIRING_CONFIG+set}" ] && ! command -v docker >/dev/null 2>&1; then
38:   echo '❌ docker недоступен — проверка НЕ выполнена' >&2
39:   exit 2
40: fi
42: if [ -z "${ENV_WIRING_CONFIG+set}" ]; then
47:   CONFIG=$(docker compose --profile app --profile edge --profile test config 2>/dev/null) || CONFIG=""
48: fi
49: if [ -z "$CONFIG" ]; then
50:   echo '❌ docker compose config нечитаем или пуст — проверка НЕ выполнена' >&2
51:   exit 2
52: fi
63: service_sources() {
64:   case "$1" in
65:     api)        echo 'apps/api' ;;
66:     recognizer) echo 'apps/recognizer' ;;
67:     web)        echo 'apps/web' ;;
69:   esac
70: }
72: echo '== Переменные, читаемые кодом, доезжают до сервиса =='
74: for svc in api recognizer web; do
75:   dirs=$(service_sources "$svc")
76:   [ -z "$dirs" ] && continue
77:   [ -d "$dirs" ] || { echo "  ⚠️  $svc: каталог $dirs отсутствует — пропуск"; continue; }
91:   used=$(find "$dirs" -type d \( -name node_modules -o -name .next -o -name dist \) -prune -o \
92:            -type f \( -name '*.ts' -o -name '*.tsx' -o -name '*.js' -o -name '*.mjs' \) -print 2>/dev/null \
93:          | xargs -r cat 2>/dev/null \
94:          | grep -vE '^[[:space:]]*(//|\*|/\*)' \
95:          | grep -oE "(^|[^A-Za-z0-9_])env\.[A-Z][A-Z0-9_]*|(^|[^A-Za-z0-9_])env\[['\"][A-Z][A-Z0-9_]*" \
96:          | grep -oE '[A-Z][A-Z0-9_]*$' | sort -u)
97:   if [ -z "$used" ]; then
98:     echo "  ⚠️  $svc: ни одной переменной не читается — проверять нечего"
99:     continue
100:   fi
102:   passed=$(printf '%s\n' "$CONFIG" \
103:            | awk -v svc="  $svc:" '
104:                $0 == svc { inside = 1; next }
105:                /^  [a-zA-Z0-9_-]+:$/ { inside = 0 }
106:                inside { print }
107:              ' \
108:            | grep -oE '^[[:space:]]+[A-Z][A-Z0-9_]*:' | tr -d ' :' | sort -u)
111:   if ! printf '%s\n' "$CONFIG" | grep -qxE "  $svc:"; then
112:     echo "❌ сервис $svc отсутствует в docker compose config — проверка НЕ выполнена" >&2
113:     exit 2
114:   fi
116:   missing=$(comm -23 <(echo "$used") <(echo "$passed") | grep -vxE "$ALLOWED" || true)
118:   if [ -n "$missing" ]; then
119:     while read -r v; do
120:       [ -n "$v" ] && { printf '  ❌ %s: %s читается кодом, но не передаётся сервису\n' "$svc" "$v"; FAIL=1; }
121:     done <<<"$missing"
122:   else
123:     printf '  ✅ %s: все читаемые переменные проброшены\n' "$svc"
124:   fi
125: done
127: if [ "$FAIL" -ne 0 ]; then
128:   echo
129:   echo '     Добавить в environment соответствующего сервиса docker-compose.yml.'
130:   echo '     Приложение стартует и без них — ошибка видна только в поведении.'
131: fi
132: exit $FAIL

hook: PreToolUse
hook: PreToolUse Completed
exec
/bin/bash -lc 'cat docker-compose.yml Dockerfile Caddyfile packages/db/migrations/*.sql' in /home/dz-projects-2026/2026-AUG-PU-Projects/2026-AUG-PU-Projects/projects/04-calorie-vision-cal-ai
 succeeded in 31ms:
# N4 «Тарелка» — скелет стека. Код ещё не написан: сервисы api/recognizer/web НЕ соберутся,
# пока фича `foundation` не создаст package.json монорепо и исходники. Поэтому они собраны в
# профиль `app` — без него поднимаются только db и storage, и файл остаётся проверяемым
# (`docker compose config`) до появления кода.
#
# Перед ЛЮБЫМ `docker compose up`:
#   node ../../.claude/hooks/check-ports.cjs .          # что смотрит наружу (Правило №0)
#   bash ../../scripts/check-port-conflicts.sh .        # свободно ли то, что мы просим
# Две проверки, а не одна: это разные вопросы, и ни одна не заменяет другую.
name: ${N4_COMPOSE_PROJECT:-n4-tarelka}

services:

  # ─── Данные. Публикации на хост нет вовсе: соседи по сети compose ходят по имени db:5432 ───
  db:
    image: postgres:16.15-alpine@sha256:cf78e76683b9ca8c5733cbbdce6c9262b45b6767934dd0a95e671f9a0fc20685
    restart: unless-stopped
    environment:
      POSTGRES_USER: n4_admin
      POSTGRES_DB: n4
      POSTGRES_PASSWORD: ${N4_DB_ADMIN_PASSWORD:?задайте пароль администратора БД — пустое значение не означает «без пароля»}
      # Пароль роли приложения нужен БУТСТРАПУ кластера: роль — объект кластера, и её
      # пароль не имеет права лежать в SQL-файле, который коммитится (фича foundation).
      N4_DB_APP_PASSWORD: ${N4_DB_APP_PASSWORD:?задайте пароль роли приложения}
      TZ: Europe/Moscow
    # expose — документирующая запись; доступ внутри сети есть и без неё. Публикации нет.
    expose: ["5432"]
    volumes:
      - db-data:/var/lib/postgresql/data
      # Роли n4_migrate и n4_app создаются ОДИН раз при первой инициализации тома.
      # Таблицы создаёт миграция 001 из-под n4_migrate — это уже объекты схемы.
      - ./scripts/init-foundation-db.sh:/docker-entrypoint-initdb.d/10-init-foundation-db.sh:ro
    networks: [private]
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U n4_admin -d n4"]
      interval: 2s
      timeout: 2s
      retries: 30

  # ─── Приватный бакет фото. Портов не публикует; консоль наружу не выставляется ───
  storage:
    image: minio/minio:RELEASE.2025-04-22T22-12-26Z@sha256:a1ea29fa28355559ef137d71fc570e508a214ec84ff8083e39bc5428980b015e
    restart: unless-stopped
    command: server /data --console-address ":9001"
    environment:
      MINIO_ROOT_USER: ${N4_STORAGE_ROOT_USER:?задайте пользователя MinIO — minioadmin это готовая точка входа, а не «временно для тестов»}
      MINIO_ROOT_PASSWORD: ${N4_STORAGE_ROOT_PASSWORD:?задайте пароль MinIO — значение по умолчанию запрещено}
      TZ: Europe/Moscow
    expose: ["9000", "9001"]
    volumes:
      - storage-data:/data
    networks: [private]
    healthcheck:
      test: ["CMD", "mc", "ready", "local"]
      interval: 5s
      timeout: 3s
      retries: 20

  # ─── API: 13 маршрутов канона, приём и нормализация фото, квоты, initData ───
  api:
    build:
      context: .
      target: api
    # `edge` в списке — не украшение: proxy зависит от api и web, и профиль `edge`
    # БЕЗ них не поднимается вовсе («depends on undefined service»). Найдено первым
    # настоящим запуском профиля edge.
    profiles: [app, dev, edge]
    restart: unless-stopped
    environment:
      NODE_ENV: production
      TZ: Europe/Moscow
      # Дефолта нет намеренно: APP_ORIGIN определяет КАЖДУЮ выдаваемую наружу ссылку,
      # и тихий localhost сделал бы все выданные адреса нерабочими при зелёных тестах.
      APP_ORIGIN: ${APP_ORIGIN:?внешний адрес обязателен — он определяет каждую выдаваемую ссылку}
      # Роль n4_app создаётся миграцией 001 (фича foundation), а не этим файлом.
      DATABASE_URL: postgresql://n4_app:${N4_DB_APP_PASSWORD:?задайте пароль роли приложения}@db:5432/n4
      S3_ENDPOINT: http://storage:9000
      S3_BUCKET: ${N4_S3_BUCKET:-n4-photos}
      S3_ACCESS_KEY: ${N4_S3_ACCESS_KEY:?задайте ключ доступа приложения к бакету}
      S3_SECRET_KEY: ${N4_S3_SECRET_KEY:?задайте секрет доступа приложения к бакету}
      # Токен бота — только здесь: из него производится секрет HMAC для проверки initData.
      TELEGRAM_BOT_TOKEN: ${TELEGRAM_BOT_TOKEN:?токен бота обязателен — без него вход через Mini App неисполним}
      # ТРИ потолка. Отсутствие ЛЮБОГО обязано валить старт процесса (ADR-007): проверка
      # одной переменной зеленеет при отсутствующей второй, поэтому объявлены все три.
      N4_SCAN_LIMIT_USER: ${N4_SCAN_LIMIT_USER:?потолок на пользователя не задан — пустое значение не означает «без ограничений»}
      N4_SCAN_LIMIT_DAY: ${N4_SCAN_LIMIT_DAY:?суточный потолок попыток не задан}
      N4_ESCALATION_LIMIT_DAY: ${N4_ESCALATION_LIMIT_DAY:?суточный потолок эскалаций не задан}
      # Пороги ограничения частоты — числа канона §7 (DEC-A-013): 30 мутаций и 120 чтений
      # в минуту на один ip_prefix. Отсутствие валит старт наравне с потолками: предел,
      # которого нет, — это отсутствие предела, а не «по умолчанию разумно».
      N4_RATE_LIMIT_MUTATE_PER_MIN: ${N4_RATE_LIMIT_MUTATE_PER_MIN:?порог частоты для мутирующих маршрутов не задан}
      N4_RATE_LIMIT_READ_PER_MIN: ${N4_RATE_LIMIT_READ_PER_MIN:?порог частоты для чтения не задан}
    expose: ["3000"]
    networks: [private, egress]
    depends_on:
      db: { condition: service_healthy }
      storage: { condition: service_healthy }
    healthcheck:
      # Проба переведена с TCP на HTTP в фиче `foundation`: служебный `GET /health` введён
      # решением по канону (он ВНЕ префикса /api/v1, продуктовых маршрутов по-прежнему 14).
      # Разница содержательна: TCP-проба говорит «процесс слушает», а этот ответ означает,
      # что база отвечает на SELECT 1. При недоступной базе он даёт 503, и сервис перестаёт
      # быть healthy — недоступность источника истины обязана быть видна, а не подразумеваться.
      test: ["CMD", "node", "-e", "require('http').get('http://127.0.0.1:3000/health',function(r){process.exit(r.statusCode===200?0:1)}).on('error',function(){process.exit(1)})"]
      interval: 5s
      timeout: 3s
      retries: 20

  # ─── Воркер распознавания: единственный сервис, у которого есть чем позвать модель ───
  recognizer:
    build:
      context: .
      target: recognizer
    profiles: [app, dev, edge]
    restart: unless-stopped
    environment:
      NODE_ENV: production
      TZ: Europe/Moscow
      DATABASE_URL: postgresql://n4_app:${N4_DB_APP_PASSWORD:?задайте пароль роли приложения}@db:5432/n4
      S3_ENDPOINT: http://storage:9000
      S3_BUCKET: ${N4_S3_BUCKET:-n4-photos}
      S3_ACCESS_KEY: ${N4_S3_ACCESS_KEY:?задайте ключ доступа приложения к бакету}
      S3_SECRET_KEY: ${N4_S3_SECRET_KEY:?задайте секрет доступа приложения к бакету}
      # Выбор реализации адаптера. Закрытый набор значений принадлежит КОДУ (fake | live),
      # переменная только выбирает. Безопасное значение по умолчанию — fake: оно не тратит денег.
      N4_MODEL_PROVIDER: ${N4_MODEL_PROVIDER:-fake}
      # Ключа на этой машине нет (DEC-A-009). Пустое значение законно при N4_MODEL_PROVIDER=fake
      # и ОБЯЗАНО валить старт при live — проверку делает код, потому что условие зависит от режима.
      ANTHROPIC_API_KEY: ${ANTHROPIC_API_KEY:-}
      N4_SCAN_LIMIT_USER: ${N4_SCAN_LIMIT_USER:?потолок на пользователя не задан}
      N4_SCAN_LIMIT_DAY: ${N4_SCAN_LIMIT_DAY:?суточный потолок попыток не задан}
      N4_ESCALATION_LIMIT_DAY: ${N4_ESCALATION_LIMIT_DAY:?суточный потолок эскалаций не задан}
    networks: [private, egress]
    depends_on:
      db: { condition: service_healthy }
      storage: { condition: service_healthy }
    # healthcheck не объявлен осознанно: от recognizer не зависит ни один сервис, а проверка
    # «процесс жив» повторила бы restart: unless-stopped. Молчащий воркер ловится метрикой
    # «возраст старейшего задания queued > 60 с» (Completion.md, Monitoring), а не healthcheck'ом.

  # ─── Один фронт на PWA и Telegram Mini App. Секретов вызова наружу не имеет — это проверяемо ───
  web:
    build:
      context: .
      target: web
    profiles: [app, dev, edge]
    restart: unless-stopped
    environment:
      NODE_ENV: production
      TZ: Europe/Moscow
      APP_ORIGIN: ${APP_ORIGIN:?внешний адрес обязателен}
      API_INTERNAL_URL: http://api:3000
      NEXT_TELEMETRY_DISABLED: "1"
    # ХОСТОВОГО ПОРТА У web НЕТ, и это не забывчивость. Черновик публиковал
    # 127.0.0.1:${N4_WEB_PORT:-4184}:3000 «для прямой отладки»; проверка
    # `bash ../../scripts/check-port-conflicts.sh .` вернула 1 и назвала причину: web,
    # опубликованный рядом с proxy, позволяет обойти прокси ВМЕСТЕ СО ВСЕМ, что прокси
    # гарантирует. Здесь это не абстракция: Caddy держит ограничение частоты, работающее
    # ДО валидации тела (`security-operation-order`), и прямой путь к web снимает его.
    # Единственная дверь — профиль `edge` на 127.0.0.1:${N4_EDGE_PORT:-4180}.
    expose: ["3000"]
    networks: [private, egress]
    depends_on:
      api: { condition: service_healthy }
    healthcheck:
      test: ["CMD", "node", "-e", "require('net').connect(3000,'127.0.0.1').on('connect',function(){process.exit(0)}).on('error',function(){process.exit(1)})"]
      interval: 5s
      timeout: 3s
      retries: 20

  # ─── Единственная публичная дверь: TLS, ограничение частоты ДО валидации, CSP.
  #     CORS-заголовков НЕ ставит: web и api на одном origin, а два одинаковых заголовка
  #     ломают CORS молча, и curl этого не показывает.
  #     Caddyfile создаёт фича foundation; до этого профиль edge поднимать нечего. ───
  proxy:
    # Собирается из proxy/Dockerfile, а не берётся готовым: в стандартном образе нет модуля
    # ограничения частоты, а FR-foundation-8 требует его НА ДВЕРИ — приложенческий покрывает
    # только api, тогда как через дверь идёт весь трафик, включая web. Базовые образы внутри
    # закреплены дайджестом, сборка проверяет наличие модуля.
    build:
      context: ./proxy
    # Имя собранного образа объявлено явно: `up` берёт уже собранный, а на чистой машине
    # compose соберёт его по этому же Dockerfile. Рецепт остаётся в файле, а не подменяется
    # готовым образом.
    image: n4-tarelka-proxy:local
    profiles: [edge]
    restart: unless-stopped
    environment:
      TZ: Europe/Moscow
      APP_ORIGIN: ${APP_ORIGIN:?внешний адрес обязателен}
      # Пороги двери — числа канона §7 (DEC-A-013), те же 30 и 120, что у приложения, но
      # считаются ОТДЕЛЬНО и по адресу клиента двери. Значения по умолчанию нет НИ ЗДЕСЬ,
      # НИ в Caddyfile: незаданный порог валит загрузку конфигурации, и дверь не
      # поднимается — предел, которого нет, есть отсутствие предела.
      N4_PROXY_RATE_MUTATE_PER_MIN: ${N4_PROXY_RATE_MUTATE_PER_MIN:?порог частоты мутаций на двери не задан}
      N4_PROXY_RATE_READ_PER_MIN: ${N4_PROXY_RATE_READ_PER_MIN:?порог частоты чтения на двери не задан}
    # 80 и 443 заняты чужим прокси этой машины — ими не пользуемся. Петлевая публикация:
    # наружу стенд выводит вышестоящий reverse-proxy, а не этот стек.
    ports: ["127.0.0.1:${N4_EDGE_PORT:-4180}:80"]
    volumes:
      # Конфигурация двери создана фичей `foundation`. Без монтирования Caddy поднял бы
      # страницу-заглушку и стек выглядел бы рабочим, не отдавая ни одного маршрута.
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy-data:/data
      - caddy-config:/config
    networks: [private, egress]
    depends_on:
      web: { condition: service_healthy }
      api: { condition: service_healthy }
    healthcheck:
      test: ["CMD", "wget", "--spider", "-q", "http://127.0.0.1:2019/config/"]
      interval: 5s
      timeout: 3s
      retries: 20

  # ─── Разовый прогон проверок против настоящего PostgreSQL. Не сервис продукта ───
  test:
    image: node:22.22.0-bookworm-slim@sha256:dd9d21971ec4395903fa6143c2b9267d048ae01ca6d3ea96f16cb30df6187d94
    profiles: [test]
    restart: "no"
    working_dir: /workspace
    volumes: [".:/workspace"]
    environment:
      NODE_ENV: test
      TZ: Europe/Moscow
      NEXT_TELEMETRY_DISABLED: "1"
      # Миграции применяются под n4_admin с SET ROLE n4_migrate — четвёртой учётной записи
      # ради названия роли не заводится.
      DATABASE_URL: postgresql://n4_admin:${N4_DB_ADMIN_PASSWORD:?задайте пароль администратора БД}@db:5432/n4
      # Отдельное подключение ПОД РОЛЬЮ ПРИЛОЖЕНИЯ: тест прав проверяет, что n4_app не может
      # менять схему. Проверять это из-под администратора невозможно по построению.
      DATABASE_URL_APP: postgresql://n4_app:${N4_DB_APP_PASSWORD:?задайте пароль роли приложения}@db:5432/n4
      N4_RATE_LIMIT_MUTATE_PER_MIN: ${N4_RATE_LIMIT_MUTATE_PER_MIN:?порог частоты для мутирующих маршрутов не задан}
      N4_RATE_LIMIT_READ_PER_MIN: ${N4_RATE_LIMIT_READ_PER_MIN:?порог частоты для чтения не задан}
      APP_ORIGIN: ${APP_ORIGIN:?внешний адрес обязателен}
      S3_ENDPOINT: http://storage:9000
      S3_BUCKET: ${N4_S3_BUCKET:-n4-photos}
      S3_ACCESS_KEY: ${N4_S3_ACCESS_KEY:?задайте ключ доступа приложения к бакету}
      S3_SECRET_KEY: ${N4_S3_SECRET_KEY:?задайте секрет доступа приложения к бакету}
      # Тесты наружу не ходят: поставщик модели подменяется детерминированным фейком.
      N4_MODEL_PROVIDER: fake
      N4_SCAN_LIMIT_USER: ${N4_SCAN_LIMIT_USER:?потолок на пользователя не задан}
      N4_SCAN_LIMIT_DAY: ${N4_SCAN_LIMIT_DAY:?суточный потолок попыток не задан}
      N4_ESCALATION_LIMIT_DAY: ${N4_ESCALATION_LIMIT_DAY:?суточный потолок эскалаций не задан}
    networks: [private]
    depends_on:
      db: { condition: service_healthy }
      storage: { condition: service_healthy }

networks:
  # Хранилища живут только здесь: ни публикации на хост, ни выхода в интернет.
  private:
    internal: true
  # Опубликованные порты proxy/web и исходящий доступ api/recognizer к Anthropic и Telegram.
  egress:
    driver: bridge
    # ПОДСЕТЬ ЗАДАНА ЯВНО, и это третий дефект, найденный первым настоящим запуском:
    # `docker compose up` упал с «all predefined address pools have been fully subnetted».
    # На этой машине 31 чужая сеть, и обе пулы Docker по умолчанию (172.17–172.31 и
    # 192.168.0–240/20) разобраны целиком. Это тот же класс, что занятые хостовые порты:
    # машина не пустая, и адресное пространство — такой же разделяемый ресурс, как порт.
    # Значение правится под машину переменной, а не редактированием этого файла.
    ipam:
      config:
        - subnet: ${N4_EGRESS_SUBNET:-10.83.0.0/24}

volumes:
  db-data:
  storage-data:
  caddy-data:
  caddy-config:
# N4 «Тарелка» — multi-stage для монорепо npm workspaces.
# Контекст сборки — КОРЕНЬ проекта: package-lock.json лежит только там, и из подпапки
# `npm ci` невозможен. Пять граблей workspaces в Docker учтены явно
# (../../.claude/rules/compose-hygiene.md, правило 5).
#
# Проверен сборкой в фиче `foundation` (2026-09-12): три цели собраны, стек поднят.
# До этого файл был контрактом, а не артефактом; правило 6 того же документа требует
# проверять запуском, и первая же сборка нашла в нём дефект — см. комментарий у stage `build`.

# ─────────────────────────────────────────────────────────────────────────────
FROM node:22.22.0-bookworm-slim@sha256:dd9d21971ec4395903fa6143c2b9267d048ae01ca6d3ea96f16cb30df6187d94 AS deps
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

# ПРО `sharp` И HEIC/HEIF. Проверка наличия HEIF стояла в stage `build` и была ПЕРВЫМ
# дефектом, который нашла первая настоящая сборка: `sharp` не является зависимостью фичи
# `foundation` (нормализация фото — фича `scan-pipeline`, `03_architecture.md`), поэтому
# `require('sharp')` валил сборку всех трёх образов на пустом месте.
# Проверка не отменена, а ПЕРЕНЕСЕНА туда, где появится сама зависимость: страж обязан
# стоять там, где есть что стеречь, иначе его снимают целиком при первой же красной сборке.
# Формулировка для переноса: стандартная предсобранная libvips поддержку HEIF НЕ включает;
# молча уронить HEIC нельзя — это отказ половине аудитории на первом кадре.

# npm ci сверяет ВЕСЬ lock-tree, поэтому манифесты нужны от ВСЕХ workspace, а не от одного.
COPY package.json package-lock.json ./
COPY apps/web/package.json          apps/web/package.json
COPY apps/api/package.json          apps/api/package.json
COPY apps/recognizer/package.json   apps/recognizer/package.json
COPY packages/db/package.json       packages/db/package.json
COPY packages/shared/package.json   packages/shared/package.json
RUN npm ci --ignore-scripts

# ─────────────────────────────────────────────────────────────────────────────
FROM deps AS build
WORKDIR /app
# .dockerignore обязателен: без него COPY . . утащит node_modules, .next и .env в слой.
COPY . .
# ВТОРОЙ дефект, найденный первой настоящей сборкой: `npm run build --workspaces` идёт в
# порядке ОБЪЯВЛЕНИЯ (`apps/*` раньше `packages/*`), а не в порядке зависимостей, и
# `apps/api` компилировался, когда `packages/shared/dist` ещё не существовал — восемнадцать
# ошибок «Cannot find module '@n4/shared'». Порядок объявлен ЯВНО в корневом скрипте
# `build`: пакеты, потом приложения. Одно место, а не два.
RUN npm run build

# ─────────────────────────────────────────────────────────────────────────────
FROM node:22.22.0-bookworm-slim@sha256:dd9d21971ec4395903fa6143c2b9267d048ae01ca6d3ea96f16cb30df6187d94 AS api
WORKDIR /app
ENV NODE_ENV=production TZ=Europe/Moscow
# COPY из ПУТИ WORKSPACE, а не из /app: сборка кладёт результат в apps/api/dist,
# и COPY /app/dist дал бы рантайм на пустом месте.
COPY --from=build --chown=node:node /app/node_modules            /app/node_modules
COPY --from=build --chown=node:node /app/package.json            /app/package.json
COPY --from=build --chown=node:node /app/packages                /app/packages
COPY --from=build --chown=node:node /app/apps/api/package.json   /app/apps/api/package.json
COPY --from=build --chown=node:node /app/apps/api/dist           /app/apps/api/dist
USER node
EXPOSE 3000
WORKDIR /app/apps/api
# CMD указывает на скрипт, существующий в ЭТОМ package.json, а не в корневом манифесте.
CMD ["npm", "run", "start"]

# ─────────────────────────────────────────────────────────────────────────────
FROM node:22.22.0-bookworm-slim@sha256:dd9d21971ec4395903fa6143c2b9267d048ae01ca6d3ea96f16cb30df6187d94 AS recognizer
WORKDIR /app
ENV NODE_ENV=production TZ=Europe/Moscow
COPY --from=build --chown=node:node /app/node_modules                   /app/node_modules
COPY --from=build --chown=node:node /app/package.json                   /app/package.json
COPY --from=build --chown=node:node /app/packages                       /app/packages
COPY --from=build --chown=node:node /app/apps/recognizer/package.json   /app/apps/recognizer/package.json
COPY --from=build --chown=node:node /app/apps/recognizer/dist           /app/apps/recognizer/dist
USER node
# Портов не слушает вовсе: HTTP-запросов извне не принимает (Architecture.md, Component Breakdown).
WORKDIR /app/apps/recognizer
CMD ["npm", "run", "start"]

# ─────────────────────────────────────────────────────────────────────────────
FROM node:22.22.0-bookworm-slim@sha256:dd9d21971ec4395903fa6143c2b9267d048ae01ca6d3ea96f16cb30df6187d94 AS web
WORKDIR /app
ENV NODE_ENV=production TZ=Europe/Moscow NEXT_TELEMETRY_DISABLED=1
# Секретов вызова наружу у web нет и не появляется: ни ключа модели, ни токена бота.
COPY --from=build --chown=node:node /app/node_modules            /app/node_modules
COPY --from=build --chown=node:node /app/package.json            /app/package.json
COPY --from=build --chown=node:node /app/packages                /app/packages
COPY --from=build --chown=node:node /app/apps/web/package.json   /app/apps/web/package.json
COPY --from=build --chown=node:node /app/apps/web/.next          /app/apps/web/.next
COPY --from=build --chown=node:node /app/apps/web/public         /app/apps/web/public
USER node
EXPOSE 3000
WORKDIR /app/apps/web
CMD ["npm", "run", "start"]
# Единственная дверь стека (профиль `edge`).
#
# Что эта дверь НЕ делает и почему это записано, а не подразумевается:
#
# 1. НЕ ставит CORS-заголовков. `web` и `api` живут на ОДНОМ origin, а два одинаковых
#    заголовка ломают CORS молча, и `curl` этого не показывает — он политику браузера не
#    применяет (`deployment-seams.md`).
# 2. НЕ ставит Content-Security-Policy. CSP ставит РОВНО ОДНО место — `apps/web/middleware.ts`,
#    потому что политика обязана нести nonce, известный только тому, кто отрисовал страницу.
#    Заголовок, поставленный здесь ВТОРЫМ, дал бы браузеру пересечение двух политик и
#    сломал бы страницу тем же молчаливым способом, что и двойной CORS.
# 3. ОГРАНИЧИВАЕТ ЧАСТОТУ — и это ДВЕ РАЗНЫЕ защиты, а не дубль. Приложенческий ограничитель
#    (`apps/api/src/http/rate-limit.ts`) покрывает только `api` и работает ДО разбора тела;
#    здесь ограничивается ВЕСЬ трафик двери, включая `web` и статику, до того как запрос
#    вообще войдёт в сеть compose. Модуля нет в стандартном образе, поэтому дверь собирается
#    из `proxy/Dockerfile` (`xcaddy` + `caddy-ratelimit`), а сборка ПРОВЕРЯЕТ наличие модуля:
#    «собралось» и «ограничение работает» — разные утверждения.

{
	# Стенд слушает по HTTP на петле; TLS терминирует вышестоящий reverse-proxy машины.
	auto_https off
	# Директива стороннего модуля не входит в стандартный порядок — порядок задаётся явно,
	# и задаётся ПЕРВЫМ: ограничение частоты, срабатывающее после проксирования, не защищает
	# ничего.
	order rate_limit before basicauth
	# Административный API остаётся на 127.0.0.1:2019 внутри контейнера — он и есть проба
	# здоровья из compose. Наружу не публикуется.
}

:80 {
	# ДВА порога, а не один: канон §7 (DEC-A-013) различает мутации и чтение — 30 и 120
	# запросов в минуту на адрес. Один общий порог либо душит чтение страницы со статикой,
	# либо оставляет мутации на уровне чтения; и то и другое — не тот предел, что объявлен.
	#
	# Пороги приходят из окружения и НЕ имеют значения по умолчанию: незаданная переменная
	# валит загрузку конфигурации, то есть дверь не поднимается вовсе. Предел, которого нет,
	# — это отсутствие предела, а не «по умолчанию разумно».
	#
	# Ключ — {remote_host}, адрес непосредственного клиента двери. Заголовкам клиента здесь
	# доверия нет: дверь на то и дверь, что перед ней ничего нашего не стоит.
	@mutations not method GET HEAD OPTIONS
	rate_limit @mutations {
		zone door_mutate {
			key {remote_host}
			events {$N4_PROXY_RATE_MUTATE_PER_MIN}
			window 1m
		}
	}

	@reads method GET HEAD OPTIONS
	rate_limit @reads {
		zone door_read {
			key {remote_host}
			events {$N4_PROXY_RATE_READ_PER_MIN}
			window 1m
		}
	}

	encode gzip

	# Публичная карточка не кэшируется НИКЕМ: отзыв согласия обязан закрыть уже
	# опубликованный адрес за 60 секунд, а кэш сделал бы этот срок недостижимым.
	@card path /c/*
	header @card Cache-Control "no-store"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}

	# Продуктовые маршруты канона и служебная проба здоровья — в `api`.
	handle /api/* {
		reverse_proxy api:3000
	}
	handle /health {
		reverse_proxy api:3000
	}

	# Всё остальное — фронт. Caddy дописывает адрес клиента в КОНЕЦ X-Forwarded-For,
	# и именно последний элемент читает `api`: он поставлен НАШИМ прокси.
	handle {
		reverse_proxy web:3000
	}
}
-- N4 «Тарелка» — схема на ВСЕ 14 сущностей канона §4 (FR-foundation-3).
--
-- Источник физики — docs/Architecture.md (Data Architecture); источник логических полей и
-- закрытых наборов — docs/Pseudocode.md (Data Structures). Здесь ничего не изобретается.
--
-- Роли (n4_migrate — владелец схемы, n4_app — DML без права менять схему) создаются
-- бутстрапом кластера scripts/init-foundation-db.sh: роль — объект КЛАСТЕРА, а её пароль
-- не имеет права лежать в файле, который коммитится. Эта миграция выдаёт роли n4_app
-- права на созданные ниже объекты и назначает ALTER DEFAULT PRIVILEGES, чтобы таблица
-- следующей миграции была видна приложению сразу, а не после ручной правки грантов.

-- Расширение нечёткого поиска по названию продукта (ADR-006). pg_trgm — доверенное
-- расширение, поэтому его ставит владелец схемы, а не суперпользователь.
CREATE EXTENSION IF NOT EXISTS pg_trgm;

-- ─── Закрытые перечисления. Каждое — ровно столько значений, сколько в каноне ───────────
CREATE TYPE account_status          AS ENUM ('active', 'erasing', 'erased');
CREATE TYPE photo_file_state        AS ENUM ('present', 'purged');
CREATE TYPE recognition_status      AS ENUM ('queued', 'done', 'failed', 'refused');
CREATE TYPE recognition_failure_reason AS ENUM (
  'provider_unavailable', 'provider_timeout', 'schema_violation',
  'no_food_detected', 'no_food_matched',
  'quota_exhausted_user', 'quota_exhausted_global', 'quota_exhausted_escalation');
CREATE TYPE meal_slot               AS ENUM ('breakfast', 'lunch', 'dinner', 'snack');
CREATE TYPE partner_status          AS ENUM ('active', 'suspended');
CREATE TYPE partner_code_status     AS ENUM ('active', 'blocked');
CREATE TYPE partner_code_block_reason AS ENUM ('antifraud_ip_burst', 'manual');
CREATE TYPE attribution_status      AS ENUM ('pending', 'activated', 'rejected');
CREATE TYPE attribution_source      AS ENUM ('explicit', 'deeplink', 'cookie');
CREATE TYPE attribution_reject_reason AS ENUM ('self_referral', 'code_blocked', 'antifraud_ip_burst');
CREATE TYPE quota_scope             AS ENUM ('user', 'global', 'escalation');
CREATE TYPE growth_event_type       AS ENUM ('install', 'activation', 'share_click', 'card_view', 'code_applied');
CREATE TYPE pro_interest_contact_kind  AS ENUM ('email', 'telegram');
CREATE TYPE pro_interest_source_screen AS ENUM ('user_limit', 'global_limit');

-- ─── 1. account ────────────────────────────────────────────────────────────────────────
-- Появляется только после входа через Telegram. `status` выразим в состоянии «удаляется»:
-- удаление по запросу длится до 72 часов, и всё это время строка обязана существовать,
-- иначе повторный запрос не отличить от выполненного.
CREATE TABLE account (
  id                    uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  created_at            timestamptz NOT NULL DEFAULT now(),
  telegram_user_id      text        NOT NULL,
  tier                  text        NOT NULL DEFAULT 'free',
  consent_version       text,
  consent_text_hash     text,
  consent_at            timestamptz,
  deletion_requested_at timestamptz,
  status                account_status NOT NULL DEFAULT 'active',
  CONSTRAINT account_telegram_user_id_unique UNIQUE (telegram_user_id)
);

-- ─── 2. device_session ─────────────────────────────────────────────────────────────────
-- Хранится ХЭШ токена cookie, а не токен: утечка дампа не должна выдавать действующие
-- сессии. Адрес хранится УСЕЧЁННЫМ префиксом — полного адреса нет нигде.
CREATE TABLE device_session (
  id                         uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  created_at                 timestamptz NOT NULL DEFAULT now(),
  account_id                 uuid REFERENCES account(id) ON DELETE SET NULL,
  cookie_token_hash          text        NOT NULL,
  ip_prefix                  text        NOT NULL,
  last_seen_at               timestamptz NOT NULL DEFAULT now(),
  anonymous_diary_expires_at timestamptz NOT NULL,
  CONSTRAINT device_session_cookie_token_hash_unique UNIQUE (cookie_token_hash)
);
CREATE INDEX device_session_anonymous_expiry_idx ON device_session (anonymous_diary_expires_at);

-- ─── 3. photo ──────────────────────────────────────────────────────────────────────────
-- Байты — в приватном бакете; здесь только ключ объекта и метаданные. Строка после уборки
-- СОХРАНЯЕТСЯ в состоянии `purged`: удаление строки оставило бы дневник со ссылкой на
-- пустоту. Частичный индекс по `expires_on` — без него суточная уборка читает всю таблицу.
CREATE TABLE photo (
  id                    uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  created_at            timestamptz NOT NULL DEFAULT now(),
  device_session_id     uuid        NOT NULL REFERENCES device_session(id) ON DELETE CASCADE,
  object_key            text        NOT NULL,
  mime                  text        NOT NULL CHECK (mime IN ('image/jpeg', 'image/png', 'image/webp', 'image/heic')),
  bytes                 integer     NOT NULL CHECK (bytes > 0),
  width                 integer     NOT NULL CHECK (width > 0),
  height                integer     NOT NULL CHECK (height > 0),
  normalized_object_key text,
  normalized_bytes      integer CHECK (normalized_bytes IS NULL OR normalized_bytes > 0),
  expires_on            date        NOT NULL,
  file_state            photo_file_state NOT NULL DEFAULT 'present',
  CONSTRAINT photo_object_key_unique UNIQUE (object_key)
);
CREATE INDEX photo_expiry_present_idx ON photo (expires_on) WHERE file_state = 'present';

-- ─── 4. recognition ────────────────────────────────────────────────────────────────────
-- И запись результата, И строка очереди; второго места истины нет.
-- `leased_until` входит в предикат выборки И в индекс: после закрытия транзакции аренды
-- SKIP LOCKED не защищает ничего, и только срок аренды разделяет воркеров.
-- `lease_fence` монотонно растёт; запись результата условна по нему (ADR-003, DEC-A-008).
CREATE TABLE recognition (
  id                  uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  created_at          timestamptz NOT NULL DEFAULT now(),
  device_session_id   uuid        NOT NULL REFERENCES device_session(id) ON DELETE CASCADE,
  account_id          uuid REFERENCES account(id) ON DELETE SET NULL,
  photo_id            uuid REFERENCES photo(id) ON DELETE SET NULL,
  status              recognition_status NOT NULL DEFAULT 'queued',
  attempt_no          integer     NOT NULL DEFAULT 1 CHECK (attempt_no > 0),
  model_used          text CHECK (model_used IS NULL OR model_used IN ('haiku-4.5', 'sonnet-5')),
  escalated           boolean     NOT NULL DEFAULT false,
  confidence          real CHECK (confidence IS NULL OR (confidence >= 0 AND confidence <= 1)),
  items               jsonb       NOT NULL DEFAULT '[]'::jsonb,
  model_estimate_kcal integer CHECK (model_estimate_kcal IS NULL OR model_estimate_kcal >= 0),
  db_kcal_total       integer CHECK (db_kcal_total IS NULL OR db_kcal_total >= 0),
  discrepancy_ratio   real,
  conflict_flag       boolean     NOT NULL DEFAULT false,
  failure_reason      recognition_failure_reason,
  idempotency_key     text,
  leased_until        timestamptz,
  lease_owner         uuid,
  lease_fence         integer     NOT NULL DEFAULT 0,
  finished_at         timestamptz,
  CONSTRAINT recognition_idempotency_unique UNIQUE (device_session_id, idempotency_key)
);
CREATE INDEX recognition_queue_idx ON recognition (status, leased_until) WHERE status = 'queued';

-- ─── 5. food_item ──────────────────────────────────────────────────────────────────────
CREATE TABLE food_item (
  id                   uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  created_at           timestamptz NOT NULL DEFAULT now(),
  source               text        NOT NULL DEFAULT 'USDA-FDC',
  source_id            text        NOT NULL,
  name_en              text        NOT NULL,
  kcal_per_100g        integer     NOT NULL CHECK (kcal_per_100g >= 0),
  protein_per_100g     numeric(6,1) NOT NULL CHECK (protein_per_100g >= 0),
  fat_per_100g         numeric(6,1) NOT NULL CHECK (fat_per_100g >= 0),
  carb_per_100g        numeric(6,1) NOT NULL CHECK (carb_per_100g >= 0),
  default_portion_g    integer CHECK (default_portion_g IS NULL OR default_portion_g > 0),
  import_snapshot_date date        NOT NULL,
  CONSTRAINT food_item_source_unique UNIQUE (source, source_id)
);
CREATE INDEX food_item_name_en_trgm_idx ON food_item USING gin (name_en gin_trgm_ops);

-- ─── 6. food_synonym ───────────────────────────────────────────────────────────────────
-- Ровно ОДНО из `food_item_id` и `recipe_parts` заполнено: без строгого ИЛИ запись с
-- обоими пустыми полями читалась бы как пустая молча. Индекс триграмм — по
-- НОРМАЛИЗОВАННОЙ форме, потому что поиск идёт по ней.
CREATE TABLE food_synonym (
  id                 uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  created_at         timestamptz NOT NULL DEFAULT now(),
  name_ru            text        NOT NULL,
  name_ru_normalized text        NOT NULL,
  food_item_id       uuid REFERENCES food_item(id) ON DELETE RESTRICT,
  recipe_parts       jsonb,
  curated_by         text        NOT NULL,
  curated_at         timestamptz NOT NULL DEFAULT now(),
  CONSTRAINT food_synonym_exactly_one_form CHECK (
    (food_item_id IS NOT NULL AND recipe_parts IS NULL)
    OR (food_item_id IS NULL AND recipe_parts IS NOT NULL)
  )
);
CREATE INDEX food_synonym_normalized_trgm_idx ON food_synonym USING gin (name_ru_normalized gin_trgm_ops);

-- ─── 7. diary_entry ────────────────────────────────────────────────────────────────────
-- Дата — календарная (`date` в Europe/Moscow), а не момент времени: ужин в 23:50 по Москве
-- не должен попасть во вчера у сервера в UTC. Удаление мягкое, поэтому индекс частичный.
CREATE TABLE diary_entry (
  id              uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  created_at      timestamptz NOT NULL DEFAULT now(),
  owner_key       text        NOT NULL,
  recognition_id  uuid        NOT NULL REFERENCES recognition(id) ON DELETE RESTRICT,
  eaten_on        date        NOT NULL,
  meal_slot       meal_slot   NOT NULL,
  items           jsonb       NOT NULL DEFAULT '[]'::jsonb,
  kcal_total      integer     NOT NULL CHECK (kcal_total >= 0),
  protein_total   numeric(6,1) NOT NULL CHECK (protein_total >= 0),
  fat_total       numeric(6,1) NOT NULL CHECK (fat_total >= 0),
  carb_total      numeric(6,1) NOT NULL CHECK (carb_total >= 0),
  source_snapshot jsonb       NOT NULL,
  user_corrected  boolean     NOT NULL DEFAULT false,
  deleted_at      timestamptz
);
CREATE INDEX diary_entry_owner_day_idx ON diary_entry (owner_key, eaten_on) WHERE deleted_at IS NULL;

-- ─── 8. share_card ─────────────────────────────────────────────────────────────────────
-- `id` — публичный неугадываемый адрес `/c/{card_id}`. `revoked_at` обязателен: отзыв
-- согласия закрывает уже опубликованную карточку за 60 секунд.
CREATE TABLE share_card (
  id             uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  created_at     timestamptz NOT NULL DEFAULT now(),
  owner_key      text        NOT NULL,
  recognition_id uuid        NOT NULL REFERENCES recognition(id) ON DELETE RESTRICT,
  object_key     text        NOT NULL,
  width          integer     NOT NULL DEFAULT 1080 CHECK (width = 1080),
  height         integer     NOT NULL DEFAULT 1920 CHECK (height = 1920),
  badge_rendered boolean     NOT NULL DEFAULT false,
  revoked_at     timestamptz
);
CREATE INDEX share_card_owner_idx ON share_card (owner_key, created_at);

-- ─── 9. partner ────────────────────────────────────────────────────────────────────────
CREATE TABLE partner (
  id           uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  created_at   timestamptz NOT NULL DEFAULT now(),
  display_name text        NOT NULL,
  contact      text        NOT NULL,
  account_id   uuid REFERENCES account(id) ON DELETE SET NULL,
  status       partner_status NOT NULL DEFAULT 'active'
);

-- ─── 10. partner_code ──────────────────────────────────────────────────────────────────
-- `UNIQUE (code)` в верхнем регистре — иначе два партнёра получают один код.
CREATE TABLE partner_code (
  id             uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  created_at     timestamptz NOT NULL DEFAULT now(),
  partner_id     uuid        NOT NULL REFERENCES partner(id) ON DELETE CASCADE,
  code           text        NOT NULL CHECK (code ~ '^[A-Z0-9]{4,12}$'),
  status         partner_code_status NOT NULL DEFAULT 'active',
  blocked_reason partner_code_block_reason,
  blocked_at     timestamptz,
  CONSTRAINT partner_code_code_unique UNIQUE (code)
);

-- ─── 11. attribution ───────────────────────────────────────────────────────────────────
-- `UNIQUE (device_session_id)` гарантирует ЕДИНСТВЕННОСТЬ строки, но НЕ её неизменность:
-- правило приоритета explicit > deeplink > cookie живёт в коде, и `replaced_source`
-- оставляет след замены слабого источника явным кодом.
CREATE TABLE attribution (
  id                uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  created_at        timestamptz NOT NULL DEFAULT now(),
  device_session_id uuid        NOT NULL REFERENCES device_session(id) ON DELETE CASCADE,
  partner_code_id   uuid        NOT NULL REFERENCES partner_code(id) ON DELETE RESTRICT,
  status            attribution_status NOT NULL DEFAULT 'pending',
  reject_reason     attribution_reject_reason,
  source            attribution_source NOT NULL,
  replaced_source   attribution_source,
  activated_at      timestamptz,
  CONSTRAINT attribution_device_session_unique UNIQUE (device_session_id)
);

-- ─── 12. scan_quota_counter ────────────────────────────────────────────────────────────
-- Потолок обеспечивает БАЗА: `UNIQUE (scope, scope_key, day)` плюс условие в UPDATE.
-- Третье значение `escalation` — не украшение перечисления: без своей строки потолок 600
-- не с чем сравнить (ADR-007). Колонка "limit" в кавычках: имя взято из канона дословно.
CREATE TABLE scan_quota_counter (
  id         uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  created_at timestamptz NOT NULL DEFAULT now(),
  scope      quota_scope NOT NULL,
  scope_key  text        NOT NULL,
  day        date        NOT NULL,
  used       integer     NOT NULL DEFAULT 0 CHECK (used >= 0),
  "limit"    integer     NOT NULL CHECK ("limit" > 0),
  CONSTRAINT scan_quota_counter_key_unique UNIQUE (scope, scope_key, day)
);

-- ─── 13. pro_interest ──────────────────────────────────────────────────────────────────
-- Отдельная таблица, а не колонка в `account`: интерес оставляет и аноним.
CREATE TABLE pro_interest (
  id              uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  created_at      timestamptz NOT NULL DEFAULT now(),
  owner_key       text        NOT NULL,
  contact         text        NOT NULL,
  contact_kind    pro_interest_contact_kind  NOT NULL,
  source_screen   pro_interest_source_screen NOT NULL,
  partner_code_id uuid REFERENCES partner_code(id) ON DELETE SET NULL
);
CREATE INDEX pro_interest_created_idx ON pro_interest (created_at);

-- ─── 14. growth_event ──────────────────────────────────────────────────────────────────
-- Единственный источник истины для счётчиков кабинета партнёра и метрики недели:
-- существование `share_card` доказывает, что карточка СОБРАНА, и не доказывает шеринга.
CREATE TABLE growth_event (
  id                uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  created_at        timestamptz NOT NULL DEFAULT now(),
  type              growth_event_type NOT NULL,
  device_session_id uuid        NOT NULL REFERENCES device_session(id) ON DELETE CASCADE,
  partner_code_id   uuid REFERENCES partner_code(id) ON DELETE SET NULL,
  share_card_id     uuid REFERENCES share_card(id) ON DELETE SET NULL
);
CREATE INDEX growth_event_partner_idx ON growth_event (partner_code_id, type, created_at);

-- ─── Права приложения: DML — да, DDL — нет ─────────────────────────────────────────────
-- Компрометация приложения не даёт права переписать схему. ALTER DEFAULT PRIVILEGES нужен
-- отдельно: без него таблица СЛЕДУЮЩЕЙ миграции будет невидима приложению, и дефект
-- вскроется не при миграции, а на первом чтении.
GRANT USAGE ON SCHEMA public TO n4_app;
GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO n4_app;
GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA public TO n4_app;
ALTER DEFAULT PRIVILEGES FOR ROLE n4_migrate IN SCHEMA public
  GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO n4_app;
ALTER DEFAULT PRIVILEGES FOR ROLE n4_migrate IN SCHEMA public
  GRANT USAGE, SELECT ON SEQUENCES TO n4_app;
-- Расширение закрытого набора `recognition.failure_reason` до ДЕСЯТИ значений (DEC-A-018).
--
-- Почему отдельным файлом, а не правкой 001: 001 уже применён, и раннер по построению
-- отказывается переприменять изменённый файл — расхождение схемы и журнала должно быть
-- ошибкой, а не тихой правкой задним числом. Номер файла задаёт порядок однозначно.
--
-- `timeout` нужен ЗДЕСЬ И СЕЙЧАС: уборщик застрявших заданий (`sweepStuckScans`, DEC-A-015)
-- переводит в него задание, которое не взял ни один воркер за 5 минут, и задание с
-- исчерпанными тремя захватами. Без этого значения предел `lease_fence < 3` выразить
-- нечем: задание стало бы незахватываемым и провисело бы в `queued` вечно.
--
-- `normalize` добавляется ВМЕСТЕ с ним, хотя пишет его фича `scan-pipeline`. Причина не в
-- удобстве: `Architecture.md` и `Pseudocode.md` — владельцы физической и логической модели —
-- уже объявляют набор из ДЕСЯТИ значений. Схема, отстающая от документа, который ею
-- управляет, и есть то самое «два места с одним правилом», которые расходятся молча.

ALTER TYPE recognition_failure_reason ADD VALUE IF NOT EXISTS 'timeout';
ALTER TYPE recognition_failure_reason ADD VALUE IF NOT EXISTS 'normalize';

