26: import { withTransaction, type DbPool } from '@n4/db';
27: import { CANON } from '@n4/shared';
30: export const MAX_LEASE_ATTEMPTS = 3;
32: export const SWEEP_QUEUE_AGE = '5 minutes';
34: export interface LeasedJob {
35:   readonly id: string;
36:   readonly fence: number;
37:   readonly photoId: string;
38:   readonly deviceSessionId: string;
39: }
41: const SELECT_CANDIDATE = `
42:   SELECT id FROM recognition
43:   WHERE status = 'queued'
44:     AND photo_id IS NOT NULL
45:     AND (leased_until IS NULL OR leased_until < now())
46:     AND lease_fence < $1
47:   ORDER BY created_at
48:   FOR UPDATE SKIP LOCKED
49:   LIMIT 1
50: `;
52: const TAKE_LEASE = `
53:   UPDATE recognition
54:   SET leased_until = now() + ($2 || ' seconds')::interval,
55:       lease_owner  = $3,
56:       lease_fence  = lease_fence + 1
57:   WHERE id = $1
58:   RETURNING id, lease_fence, photo_id, device_session_id
59: `;
65: export async function acquireLease(pool: DbPool, ownerId: string): Promise<LeasedJob | undefined> {
66:   return withTransaction(pool, async (client) => {
67:     const candidate = await client.query<{ id: string }>(SELECT_CANDIDATE, [MAX_LEASE_ATTEMPTS]);
68:     const row = candidate.rows[0];
69:     if (row === undefined) return undefined;
71:     const leased = await client.query<{ id: string; lease_fence: number; photo_id: string | null; device_session_id: string }>(
72:       TAKE_LEASE,
73:       [row.id, String(CANON.leaseSeconds), ownerId],
74:     );
75:     const taken = leased.rows[0];
76:     if (taken === undefined || taken.photo_id === null) return undefined;
77:     return {
78:       id: taken.id,
79:       fence: taken.lease_fence,
80:       photoId: taken.photo_id,
81:       deviceSessionId: taken.device_session_id,
82:     };
83:   });
84: }
86: export interface ResultRecord {
87:   readonly status: 'done' | 'failed' | 'refused';
88:   readonly confidence: number | null;
89:   readonly items: unknown;
90:   readonly modelEstimateKcal: number | null;
91:   readonly modelUsed: 'haiku-4.5' | 'sonnet-5' | null;
92:   readonly failureReason: string | null;
93: }
96: export type WriteOutcome = 'written' | 'stale_lease' | 'swept';
98: const WRITE_RESULT = `
99:   UPDATE recognition
100:   SET status = $3::recognition_status,
101:       confidence = $4,
102:       items = $5::jsonb,
103:       model_estimate_kcal = $6,
104:       model_used = $7,
105:       failure_reason = $8::recognition_failure_reason,
106:       finished_at = now(),
107:       leased_until = NULL,
108:       lease_owner = NULL
109:   WHERE id = $1 AND lease_fence = $2 AND status = 'queued'
110: `;
123: export async function recordResult(
124:   pool: DbPool,
125:   job: { id: string; fence: number },
126:   record: ResultRecord,
127: ): Promise<WriteOutcome> {
128:   const result = await pool.query(WRITE_RESULT, [
129:     job.id,
130:     job.fence,
131:     record.status,
132:     record.confidence,
133:     JSON.stringify(record.items ?? []),
134:     record.modelEstimateKcal,
135:     record.modelUsed,
136:     record.failureReason,
137:   ]);
138:   if ((result.rowCount ?? 0) > 0) return 'written';
140:   const current = await pool.query<{ status: string; lease_fence: number }>(
141:     'SELECT status::text AS status, lease_fence FROM recognition WHERE id = $1',
142:     [job.id],
143:   );
144:   const row = current.rows[0];
145:   if (row === undefined) return 'swept';
150:   if (row.lease_fence !== job.fence) return 'stale_lease';
151:   return row.status === 'queued' ? 'stale_lease' : 'swept';
152: }
154: export interface SweepResult {
156:   readonly neverLeased: number;
158:   readonly attemptsExhausted: number;
159: }
161: const SWEEP_NEVER_LEASED = `
162:   UPDATE recognition
163:   SET status = 'failed', failure_reason = 'timeout', finished_at = now()
164:   WHERE status = 'queued' AND leased_until IS NULL AND created_at < now() - $1::interval
165: `;
167: const SWEEP_ATTEMPTS_EXHAUSTED = `
168:   UPDATE recognition
169:   SET status = 'failed', failure_reason = 'timeout', finished_at = now()
170:   WHERE status = 'queued' AND lease_fence >= $1 AND leased_until < now()
171: `;
186: export async function sweepStuckScans(pool: DbPool, queueAge: string = SWEEP_QUEUE_AGE): Promise<SweepResult> {
187:   const neverLeased = await pool.query(SWEEP_NEVER_LEASED, [queueAge]);
188:   const attemptsExhausted = await pool.query(SWEEP_ATTEMPTS_EXHAUSTED, [MAX_LEASE_ATTEMPTS]);
189:   return {
190:     neverLeased: neverLeased.rowCount ?? 0,
191:     attemptsExhausted: attemptsExhausted.rowCount ?? 0,
192:   };
193: }

