30: function composeConfig(apiVariables: string[]): string {
31:   const block = (service: string, variables: string[]): string =>
32:     [`  ${service}:`, '    environment:', ...variables.map((name) => `      ${name}: значение`), '    image: n4/local'].join('\n');
33:   return [
