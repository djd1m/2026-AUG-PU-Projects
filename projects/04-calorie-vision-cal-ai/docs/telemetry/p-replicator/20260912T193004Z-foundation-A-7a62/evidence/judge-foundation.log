91:   used=$(find "$dirs" -type d \( -name node_modules -o -name .next -o -name dist \) -prune -o \
92:            -type f \( -name '*.ts' -o -name '*.tsx' -o -name '*.js' -o -name '*.mjs' \) -print 2>/dev/null \
93:          | xargs -r cat 2>/dev/null \
