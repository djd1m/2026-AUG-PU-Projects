+#
+# Почему отдельный образ: в стандартном `caddy:2.10-alpine` модуля ограничения частоты НЕТ,
+# и объявить директиву `rate_limit` в `Caddyfile` без него значит объявить защиту, которой
+# не существует, — конфигурация просто не загрузится. FR-foundation-8 требует ограничение
+# НА ДВЕРИ дополнительно к приложенческому: приложенческое покрывает только `api`, а через
+# дверь идёт ВЕСЬ трафик, включая `web`.
+#
+# Образы закреплены дайджестом: `caddy:2.10-builder-alpine` и `caddy:2.10-alpine` — плавающий
+# тег через месяц приедет другим, и сборка перестанет быть воспроизводимой.
+
+FROM caddy:2.10-builder-alpine@sha256:4cff3ae272ea05842adb4546e35961e4947aeea65f80fa1eb62a35b960e84971 AS builder
+# Модуль третьей стороны, собирается в бинарь Caddy. Версия НЕ плавающая: пин по коммиту
+# делает сборку воспроизводимой, а обновление — осознанным действием.
+RUN xcaddy build --with github.com/mholt/caddy-ratelimit@v0.1.0
+
+FROM caddy:2.10-alpine@sha256:4c6e91c6ed0e2fa03efd5b44747b625fec79bc9cd06ac5235a779726618e530d
+COPY --from=builder /usr/bin/caddy /usr/bin/caddy
+# Проверка НА СБОРКЕ: модуль обязан присутствовать в бинаре. Без неё «собралось» и
+# «ограничение частоты работает» — разные утверждения, и второе никто не проверял.
+RUN caddy list-modules | grep -q 'http.handlers.rate_limit'
