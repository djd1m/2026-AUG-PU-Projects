diff --git a/projects/04-calorie-vision-cal-ai/apps/web/app/globals.css b/projects/04-calorie-vision-cal-ai/apps/web/app/globals.css
new file mode 100644
index 0000000..2309ca0
--- /dev/null
+++ b/projects/04-calorie-vision-cal-ai/apps/web/app/globals.css
@@ -0,0 +1,73 @@
+/* Видоискатель занимает экран целиком: первый экран — камера, а не оболочка вокруг неё. */
+:root {
+  --ink: #f4f4f5;
+  --ground: #101014;
+  --accent: #7ee081;
+  color-scheme: dark;
+}
+* { box-sizing: border-box; }
+html, body {
+  margin: 0;
+  padding: 0;
+  height: 100%;
+  background: var(--ground);
+  color: var(--ink);
+  font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
+}
+.screen {
+  position: relative;
+  display: flex;
+  flex-direction: column;
+  justify-content: flex-end;
+  align-items: center;
+  gap: 16px;
+  min-height: 100dvh;
+  padding: 0 0 32px;
+}
+.viewfinder { position: absolute; inset: 0; overflow: hidden; }
+.viewfinder__video { width: 100%; height: 100%; object-fit: cover; background: #000; }
+/* Рамка кадра: подсказка «снимите тарелку целиком» без единого слова. */
+.viewfinder__frame {
+  position: absolute;
+  inset: 12% 8% 28%;
+  border: 2px solid rgba(244, 244, 245, 0.7);
+  border-radius: 24px;
+  box-shadow: 0 0 0 100vmax rgba(16, 16, 20, 0.45);
+}
+.viewfinder__notice {
+  position: absolute;
+  left: 50%;
+  bottom: 34%;
+  transform: translateX(-50%);
+  margin: 0;
+  max-width: 80%;
+  text-align: center;
+  font-size: 15px;
+  line-height: 1.4;
+}
+.modes { position: relative; display: flex; gap: 24px; font-size: 15px; letter-spacing: 0.02em; }
+.modes__item { opacity: 0.6; }
+.modes__item--active { opacity: 1; font-weight: 600; }
+.shutter {
+  position: relative;
+  width: 76px;
+  height: 76px;
+  border: none;
+  border-radius: 50%;
+  background: var(--ink);
+  cursor: pointer;
+}
+.shutter__ring {
+  position: absolute;
+  inset: 6px;
+  border: 3px solid var(--ground);
+  border-radius: 50%;
+}
