16: import type { DbPool } from '@n4/db';
17: import type { Logger } from '@n4/shared';
18: import { acquireLease, recordResult, sweepStuckScans, type ResultRecord } from './lease.js';
19: import { MODEL_RESPONSE_SCHEMA, ModelDeadlineExceeded, type ModelId, type ModelProvider } from './provider/types.js';
21: /**
26: export const PRIMARY_MODEL: ModelId = 'haiku-4.5';
28: /**
33: export const DEFAULT_CALL_DEADLINE_MS = 30_000;
35: export interface WorkerOptions {
36:   readonly pool: DbPool;
37:   readonly provider: ModelProvider;
38:   readonly logger: Logger;
39:   readonly ownerId?: string;
40:   readonly pollIntervalMs?: number;
41: }
43: export interface Worker {
44:   readonly ownerId: string;
45:   /** Один проход цикла. Возвращает `true`, если задание было взято. */
46:   tick(): Promise<boolean>;
47:   /** Один проход уборщика. Вынесен отдельно, чтобы его можно было проверить в одиночку. */
48:   sweep(): Promise<void>;
49:   start(): void;
50:   stop(): Promise<void>;
51: }
53: export function createWorker(options: WorkerOptions): Worker {
54:   const ownerId = options.ownerId ?? randomUUID();
55:   const interval = options.pollIntervalMs ?? 1_000;
56:   let timer: NodeJS.Timeout | undefined;
57:   let running = false;
59:   const sweep = async (): Promise<void> => {
60:     const swept = await sweepStuckScans(options.pool);
61:     if (swept.neverLeased > 0 || swept.attemptsExhausted > 0) {
62:       options.logger.warn('swept_stuck_scans', {
63:         never_leased: swept.neverLeased,
64:         attempts_exhausted: swept.attemptsExhausted,
65:       });
66:     }
67:   };
69:   const tick = async (): Promise<boolean> => {
70:     const job = await acquireLease(options.pool, ownerId);
71:     if (job === undefined) return false;
76:     const controller = new AbortController();
77:     const deadlineTimer = setTimeout(() => controller.abort(), DEFAULT_CALL_DEADLINE_MS);
79:     let record: ResultRecord;
80:     let timedOut = false;
81:     try {
82:       const response = await options.provider.recognize(
83:         { scanId: job.id, objectKey: job.photoId },
84:         MODEL_RESPONSE_SCHEMA,
86:         { model: PRIMARY_MODEL, deadlineMs: DEFAULT_CALL_DEADLINE_MS, signal: controller.signal },
87:       );
88:       record = {
89:         status: 'refused',
90:         confidence: response.confidence,
91:         items: response.items,
92:         modelEstimateKcal: response.modelEstimateKcal,
93:         modelUsed: response.model,
94:         failureReason: 'no_food_matched',
95:       };
96:     } catch (error) {
97:       if (!(error instanceof ModelDeadlineExceeded) && (error as Error)?.name !== 'AbortError') throw error;
98:       timedOut = true;
99:       record = {
100:         status: 'failed',
101:         confidence: null,
102:         items: [],
103:         modelEstimateKcal: null,
104:         modelUsed: PRIMARY_MODEL,
105:         failureReason: 'timeout',
106:       };
107:     } finally {
108:       clearTimeout(deadlineTimer);
109:     }
113:     if (timedOut) options.logger.warn('model_call_deadline_exceeded', { scan_id: job.id, fence: job.fence });
120:     const outcome = await recordResult(options.pool, job, record);
122:     if (outcome === 'stale_lease') {
124:       options.logger.warn('stale_lease_result', { scan_id: job.id, fence: job.fence, lease_owner: ownerId });
125:       return true;
126:     }
127:     if (outcome === 'swept') {
129:       options.logger.warn('swept_as_timeout', { scan_id: job.id, fence: job.fence, lease_owner: ownerId });
130:       return true;
131:     }
132:     if (!timedOut) {
133:       options.logger.info('scan_finished', {
134:         scan_id: job.id,
135:         fence: job.fence,
136:         provider: options.provider.kind,
137:         model: record.modelUsed,
138:       });
139:     }
140:     return true;
141:   };
143:   return {
144:     ownerId,
145:     tick,
146:     sweep,
147:     start() {
148:       if (timer !== undefined) return;
149:       timer = setInterval(() => {
150:         if (running) return;
151:         running = true;
152:         void tick()
153:           .then(() => sweep())
154:           .catch((error: unknown) => options.logger.error('tick_failed', { message: (error as Error).message }))
155:           .finally(() => {
156:             running = false;
157:           });
158:       }, interval);
159:     },
160:     async stop() {
161:       if (timer !== undefined) clearInterval(timer);
162:       timer = undefined;
163:     },
164:   };
165: }

