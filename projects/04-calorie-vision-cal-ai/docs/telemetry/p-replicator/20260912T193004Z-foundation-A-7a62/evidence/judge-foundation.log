17:   debug(event: string, fields?: LogFields): void;
18:   info(event: string, fields?: LogFields): void;
19:   warn(event: string, fields?: LogFields): void;
20:   error(event: string, fields?: LogFields): void;
21:   child(bound: LogFields): Logger;
22: }
24: /**
28: export const SERVICE_LOG_FIELDS: readonly string[] = [
31:   'request_id', 'event', 'route', 'method', 'status', 'code', 'signal', 'port',
32:   'variables', 'scan_limit_user', 'scan_limit_day', 'escalation_limit_day',
33:   'rate_limit_mutate_per_min', 'rate_limit_read_per_min', 'model_provider', 'model',
34:   'ip_prefix', 'scan_id', 'fence', 'lease_owner', 'provider', 'write',
35:   'never_leased', 'attempts_exhausted', 'message', 'duration_ms',
36: ];
38: export interface LoggerOptions extends RedactorOptions {
39:   readonly service: string;
40:   /** Куда писать строку. Подменяется в тестах гигиены журнала. */
41:   readonly sink?: (line: string) => void;
42:   readonly now?: () => Date;
43: }
45: export function createLogger(options: LoggerOptions): Logger {
46:   const redact = createRedactor(options);
47:   const sink = options.sink ?? ((line: string) => process.stdout.write(`${line}\n`));
48:   const now = options.now ?? (() => new Date());
50:   const emit = (level: LogLevel, event: string, bound: LogFields, fields: LogFields | undefined): void => {
51:     const payload = redact({ ...bound, ...(fields ?? {}) }) as Record<string, unknown>;
52:     sink(JSON.stringify({ time: now().toISOString(), level, service: options.service, event, ...payload }));
53:   };
55:   const build = (bound: LogFields): Logger => ({
56:     debug: (event, fields) => emit('debug', event, bound, fields),
57:     info: (event, fields) => emit('info', event, bound, fields),
58:     warn: (event, fields) => emit('warn', event, bound, fields),
59:     error: (event, fields) => emit('error', event, bound, fields),
60:     child: (extra) => build({ ...bound, ...extra }),
61:   });
63:   return build({});
64: }

FILE packages/shared/src/log/redact.ts
13: export const REDACTED = '[redacted]';
15: /** Имена полей, запрещённые к печати ЦЕЛИКОМ. Список ЯВНЫЙ и живёт в коде. */
16: export const FORBIDDEN_FIELD_NAMES: readonly string[] = [
17:   'cookie',
18:   'set-cookie',
19:   'authorization',
20:   'anthropic_api_key',
21:   'telegram_bot_token',
22:   'cookie_token',
23:   'cookie_token_hash',
24:   'session_token',
25:   'ip',
26:   'ip_address',
27:   'remote_address',
28:   'x-forwarded-for',
29:   'password',
30:   'secret',
31:   's3_secret_key',
32:   's3_access_key',
33: ];
35: const MAX_DEPTH = 6;
37: export interface RedactorOptions {
38:   /** Точные значения-секреты. Пустые и слишком короткие игнорируются: они совпали бы со всем. */
39:   readonly secrets?: readonly (string | undefined)[];
40:   readonly forbiddenFields?: readonly string[];
41:   /**
52:   readonly allowedFields?: readonly string[];
53: }
55: export function createRedactor(options: RedactorOptions = {}): (value: unknown) => unknown {
56:   const secrets = (options.secrets ?? []).filter((s): s is string => typeof s === 'string' && s.trim().length >= 8);
57:   const forbidden = new Set((options.forbiddenFields ?? FORBIDDEN_FIELD_NAMES).map((n) => n.toLowerCase()));
58:   const allowed = options.allowedFields === undefined ? undefined : new Set(options.allowedFields.map((n) => n.toLowerCase()));
60:   const redactString = (text: string): string => {
61:     let result = text;
62:     for (const secret of secrets) {
63:       if (result.includes(secret)) result = result.split(secret).join(REDACTED);
64:     }
65:     return result;
66:   };
68:   const walk = (value: unknown, depth: number): unknown => {
69:     if (depth > MAX_DEPTH) return REDACTED;
70:     if (typeof value === 'string') return redactString(value);
71:     if (value === null || typeof value !== 'object') return value;
72:     if (Array.isArray(value)) return value.map((item) => walk(item, depth + 1));
73:     if (value instanceof Error) return { name: value.name, message: redactString(value.message) };
74:     const output: Record<string, unknown> = {};
75:     for (const [key, item] of Object.entries(value as Record<string, unknown>)) {
76:       const name = key.toLowerCase();
80:       if (forbidden.has(name)) output[key] = REDACTED;
81:       else if (allowed !== undefined && !allowed.has(name)) output[key] = REDACTED;
82:       else output[key] = walk(item, depth + 1);
83:     }
84:     return output;
85:   };
87:   return (value: unknown) => walk(value, 0);
88: }

