20: import path from 'node:path';
21: import { fileURLToPath } from 'node:url';
22: import pg from 'pg';
24: export const MIGRATIONS_DIRECTORY = fileURLToPath(new URL('../migrations/', import.meta.url));
25: /** Владелец схемы. DDL выполняется только из-под него. */
26: export const MIGRATION_ROLE = 'n4_migrate';
27: const ADVISORY_LOCK = [740_004, 1] as const;
29: export interface MigrationOptions {
30:   readonly databaseUrl: string;
31:   readonly directory?: string;
32:   readonly role?: string;
33: }
35: export interface MigrationResult {
36:   readonly applied: string[];
37:   readonly skipped: string[];
38: }
40: interface MigrationFile {
41:   readonly version: number;
42:   readonly filename: string;
43:   readonly checksum: string;
44:   readonly sql: string;
45: }
47: /** Имя файла обязано начинаться с номера: `001_init.sql`. Иначе порядок не определён. */
48: export async function inventory(directory: string): Promise<MigrationFile[]> {
49:   const entries = await readdir(directory, { withFileTypes: true });
50:   const sqlFiles = entries.filter((entry) => entry.isFile() && entry.name.endsWith('.sql'));
51:   if (sqlFiles.length === 0) throw new Error(`каталог миграций пуст: ${directory}`);
53:   const files: MigrationFile[] = [];
54:   const seen = new Map<number, string>();
55:   for (const entry of sqlFiles) {
56:     const match = /^(\d+)_[A-Za-z0-9._-]+\.sql$/.exec(entry.name);
57:     if (!match || match[1] === undefined) {
58:       throw new Error(`имя файла миграции не начинается с номера: ${entry.name}`);
59:     }
60:     const version = Number.parseInt(match[1], 10);
61:     const duplicate = seen.get(version);
62:     if (duplicate !== undefined) {
64:       throw new Error(`два файла миграции с номером ${version}: ${duplicate} и ${entry.name}`);
65:     }
66:     seen.set(version, entry.name);
67:     const bytes = await readFile(path.join(directory, entry.name));
68:     files.push({
69:       version,
70:       filename: entry.name,
71:       checksum: createHash('sha256').update(bytes).digest('hex'),
72:       sql: bytes.toString('utf8'),
73:     });
74:   }
75:   return files.sort((a, b) => a.version - b.version);
76: }
78: export async function runMigrations(options: MigrationOptions): Promise<MigrationResult> {
79:   if (!options.databaseUrl || options.databaseUrl.trim() === '') {
81:     throw new Error('DATABASE_URL не задан: применять миграции некуда');
82:   }
83:   const role = options.role ?? MIGRATION_ROLE;
84:   if (!/^[a-z][a-z0-9_]{0,62}$/.test(role)) throw new Error(`недопустимое имя роли миграций: ${role}`);
85:   const files = await inventory(options.directory ?? MIGRATIONS_DIRECTORY);
87:   const client = new pg.Client({
88:     connectionString: options.databaseUrl,
89:     connectionTimeoutMillis: 5_000,
90:     application_name: 'n4-migrator',
91:   });
92:   await client.connect();
93:   let locked = false;
94:   try {
96:     await client.query('SELECT pg_advisory_lock($1, $2)', [...ADVISORY_LOCK]);
97:     locked = true;
98:     await client.query(`SET ROLE ${role}`);
100:     await client.query(`CREATE TABLE IF NOT EXISTS schema_migration (
101:       version     integer PRIMARY KEY,
102:       filename    text        NOT NULL,
103:       checksum    text        NOT NULL CHECK (checksum ~ '^[0-9a-f]{64}$'),
104:       applied_at  timestamptz NOT NULL DEFAULT now()
105:     )`);
107:     const journal = await client.query<{ version: number; filename: string; checksum: string }>(
108:       'SELECT version, filename, checksum FROM schema_migration',
109:     );
110:     const applied = new Map(journal.rows.map((row) => [row.version, row]));
111:     const local = new Map(files.map((file) => [file.version, file]));
115:     for (const [version, row] of applied) {
116:       const file = local.get(version);
117:       if (file === undefined) throw new Error(`применённая миграция ${row.filename} (версия ${version}) отсутствует в каталоге`);
118:       if (file.checksum !== row.checksum) {
119:         throw new Error(`файл миграции ${file.filename} (версия ${version}) изменён после применения: контрольная сумма не совпала`);
120:       }
121:     }
123:     const result: MigrationResult = { applied: [], skipped: [] };
124:     for (const file of files) {
125:       if (applied.has(file.version)) {
126:         result.skipped.push(file.filename);
127:         continue;
128:       }
129:       await client.query('BEGIN');
130:       try {
131:         await client.query(file.sql);
132:         await client.query('INSERT INTO schema_migration (version, filename, checksum) VALUES ($1, $2, $3)', [
133:           file.version,
134:           file.filename,
135:           file.checksum,
136:         ]);
137:         await client.query('COMMIT');
138:       } catch (error) {
139:         await client.query('ROLLBACK');
140:         throw new Error(`миграция ${file.filename} не применена: ${(error as Error).message}`);
141:       }
142:       result.applied.push(file.filename);
143:     }
144:     return result;
145:   } finally {
146:     try {
147:       if (locked) await client.query('SELECT pg_advisory_unlock($1, $2)', [...ADVISORY_LOCK]);
148:     } finally {
149:       await client.end();
150:     }
151:   }
152: }
154: const invokedDirectly =
155:   process.argv[1] !== undefined && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url);
157: if (invokedDirectly) {
158:   runMigrations({ databaseUrl: process.env.DATABASE_URL ?? '' })
159:     .then((result) => {
160:       console.log(JSON.stringify({ applied: result.applied, skipped: result.skipped }));
161:     })
162:     .catch((error: unknown) => {
163:       console.error(`миграции не применены: ${(error as Error).message}`);
164:       process.exitCode = 1;
165:     });
166: }

