46:     return { code: 0, stdout: result.stdout, stderr: result.stderr };
47:   } catch (error) {
48:     const failure = error as { code?: number; stdout?: string; stderr?: string };
49:     return { code: failure.code ?? -1, stdout: failure.stdout ?? '', stderr: failure.stderr ?? '' };
50:   }
