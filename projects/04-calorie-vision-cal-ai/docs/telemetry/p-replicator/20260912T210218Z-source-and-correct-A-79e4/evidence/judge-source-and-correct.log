-- Фича `source-and-correct` (FR-source-and-correct-9…11, ADR-001, DEC-A-023).
--
-- Номер выдан координатором явно (инструкция Phase 3, DEC-A-035 контекст): основная ветка
-- параллельно поглощает миграции 003–005 фичи `consent-and-telegram-auth`. Коллизия с
-- `diary-and-streak` (тоже претендует на следующий свободный номер по DEC-A-035) —
-- ОЖИДАЕМАЯ и разрешается интегратором при слиянии переименованием одной из двух со
-- сдвигом, тем же приёмом, что уже применён к `consent-and-telegram-auth`
-- (`docker-ports.md`-совместимый принцип: номер файла и есть порядок применения раннера,
-- раннер отказывается переприменять изменённый файл).
--
-- Новых таблиц НЕТ: канон §4 объявляет ровно 14. `food_item` и `food_synonym` уже созданы
-- `001_init.sql` вместе с `pg_trgm` и триграммными индексами — эта фича их НАПОЛНЯЕТ, а не
-- меняет схему.

ALTER TABLE recognition
  ADD COLUMN corrections        jsonb        NOT NULL DEFAULT '[]'::jsonb,
  ADD COLUMN conflict_choice    text,
  ADD COLUMN conflict_choice_at timestamptz,
  ADD COLUMN user_corrected     boolean      NOT NULL DEFAULT false;

-- Закрытое множество ОБЪЯВЛЕНО В СХЕМЕ, а не только в коде (DEC-A-023): единственное
-- допустимое значение — `take_db`. Значение `model` отвергнуто координатором — иначе
-- оценка модели стала бы источником числа через маршрут правки (ADR-001 через чёрный ход).
ALTER TABLE recognition
  ADD CONSTRAINT recognition_conflict_choice_check
    CHECK (conflict_choice IS NULL OR conflict_choice = 'take_db');

-- Парный CHECK: выбор без времени и время без выбора — разные виды полуправды, и оба
-- выглядят правдоподобно, пока их не сравнить.
ALTER TABLE recognition
  ADD CONSTRAINT recognition_conflict_choice_pair
    CHECK ((conflict_choice IS NULL) = (conflict_choice_at IS NULL));
// ЕДИНСТВЕННОЕ место, где сервис `recognizer` читает `process.env` (FR-foundation-2).
// Причина та же, что в `apps/api/src/env.ts`: страж проброса переменных сверяет чтения
// ИСХОДНИКОВ СЕРВИСА с блоком `environment:` ЭТОГО сервиса.

import {
  attempt,
  collectConfig,
  MODEL_PROVIDERS,
  optionalText,
  requireEnum,
  requirePositiveInt,
  requireText,
  ConfigError,
  type RecognizerConfig,
} from '@n4/shared';

/** Источник значений. По умолчанию — окружение процесса; тест подставляет своё. */
export type EnvSource = Readonly<Record<string, string | undefined>>;

export function loadRecognizerConfig(env: EnvSource = process.env): RecognizerConfig {
  return collectConfig<RecognizerConfig>((fail) => {
    const modelProvider = attempt(
      fail,
      () =>
        requireEnum(
          'N4_MODEL_PROVIDER',
          env.N4_MODEL_PROVIDER,
          MODEL_PROVIDERS,
          'нераспознанное значение означало бы молчаливый откат к дешёвой реализации там, где ждали живого вызова, — или наоборот, платный вызов там, где ждали фейк',
        ),
      'fake' as const,
    );

    const anthropicApiKey = optionalText(env.ANTHROPIC_API_KEY);
    // Условие зависит от РЕЖИМА, поэтому проверяет код, а не compose (DEC-A-009).
    // При `fake` пустой ключ законен; при `live` он валит старт.
    if (modelProvider === 'live' && anthropicApiKey === undefined) {
      fail(
        new ConfigError(
          'ANTHROPIC_API_KEY',
          env.ANTHROPIC_API_KEY === undefined ? 'missing' : 'empty',
          'при N4_MODEL_PROVIDER=live каждый разбор кадра — платный вызов наружу, и без ключа он невыполним',
        ),
      );
    }

    return {
      databaseUrl: attempt(
        fail,
        () => requireText('DATABASE_URL', env.DATABASE_URL, 'без строки подключения воркер не возьмёт ни одного задания'),
        '',
      ),
      storage: {
        endpoint: attempt(fail, () => requireText('S3_ENDPOINT', env.S3_ENDPOINT, 'без адреса бакета кадр нечем прочитать'), ''),
        bucket: attempt(fail, () => requireText('S3_BUCKET', env.S3_BUCKET, 'без имени бакета кадр нечем прочитать'), ''),
        accessKey: attempt(fail, () => requireText('S3_ACCESS_KEY', env.S3_ACCESS_KEY, 'отсутствующий секрет доступа к бакету — отказ, а не анонимный доступ'), ''),
        secretKey: attempt(fail, () => requireText('S3_SECRET_KEY', env.S3_SECRET_KEY, 'отсутствующий секрет доступа к бакету — отказ, а не анонимный доступ'), ''),
      },
      quota: {
        scanLimitUser: attempt(
          fail,
          () => requirePositiveInt('N4_SCAN_LIMIT_USER', env.N4_SCAN_LIMIT_USER, 'незаданный личный потолок означал бы неограниченные платные вызовы от одного посетителя'),
          0,
        ),
        scanLimitDay: attempt(
          fail,
          () => requirePositiveInt('N4_SCAN_LIMIT_DAY', env.N4_SCAN_LIMIT_DAY, 'незаданный суточный потолок означал бы счёт без верхней границы'),
          0,
        ),
        escalationLimitDay: attempt(
          fail,
          () => requirePositiveInt('N4_ESCALATION_LIMIT_DAY', env.N4_ESCALATION_LIMIT_DAY, 'незаданный потолок эскалаций означал бы, что дорогая модель ограничена только общим потолком'),
          0,
        ),
      },
      modelProvider,
      anthropicApiKey,
    };
  });
}

export const RECOGNIZER_REQUIRED_VARIABLES: readonly string[] = [
  'DATABASE_URL',
  'S3_ENDPOINT',
  'S3_BUCKET',
  'S3_ACCESS_KEY',
  'S3_SECRET_KEY',
  'N4_SCAN_LIMIT_USER',
  'N4_SCAN_LIMIT_DAY',
  'N4_ESCALATION_LIMIT_DAY',
  'N4_MODEL_PROVIDER',
];
  # ─── API: 13 маршрутов канона, приём и нормализация фото, квоты, initData ───
  api:
    build:
      context: .
      target: api
    # `edge` в списке — не украшение: proxy зависит от api и web, и профиль `edge`
    # БЕЗ них не поднимается вовсе («depends on undefined service»). Найдено первым
    # настоящим запуском профиля edge.
    profiles: [app, dev, edge]
    restart: unless-stopped
    environment:
      NODE_ENV: production
      TZ: Europe/Moscow
      # Дефолта нет намеренно: APP_ORIGIN определяет КАЖДУЮ выдаваемую наружу ссылку,
      # и тихий localhost сделал бы все выданные адреса нерабочими при зелёных тестах.
      APP_ORIGIN: ${APP_ORIGIN:?внешний адрес обязателен — он определяет каждую выдаваемую ссылку}
      # Роль n4_app создаётся миграцией 001 (фича foundation), а не этим файлом.
      DATABASE_URL: postgresql://n4_app:${N4_DB_APP_PASSWORD:?задайте пароль роли приложения}@db:5432/n4
      S3_ENDPOINT: http://storage:9000
      S3_BUCKET: ${N4_S3_BUCKET:-n4-photos}
      S3_ACCESS_KEY: ${N4_S3_ACCESS_KEY:?задайте ключ доступа приложения к бакету}
      S3_SECRET_KEY: ${N4_S3_SECRET_KEY:?задайте секрет доступа приложения к бакету}
      # Токен бота — только здесь: из него производится секрет HMAC для проверки initData.
      TELEGRAM_BOT_TOKEN: ${TELEGRAM_BOT_TOKEN:?токен бота обязателен — без него вход через Mini App неисполним}
      # ТРИ потолка. Отсутствие ЛЮБОГО обязано валить старт процесса (ADR-007): проверка
      # одной переменной зеленеет при отсутствующей второй, поэтому объявлены все три.
      N4_SCAN_LIMIT_USER: ${N4_SCAN_LIMIT_USER:?потолок на пользователя не задан — пустое значение не означает «без ограничений»}
      N4_SCAN_LIMIT_DAY: ${N4_SCAN_LIMIT_DAY:?суточный потолок попыток не задан}
      N4_ESCALATION_LIMIT_DAY: ${N4_ESCALATION_LIMIT_DAY:?суточный потолок эскалаций не задан}
      # Пороги ограничения частоты — числа канона §7 (DEC-A-013): 30 мутаций и 120 чтений
      # в минуту на один ip_prefix. Отсутствие валит старт наравне с потолками: предел,
      # которого нет, — это отсутствие предела, а не «по умолчанию разумно».
      N4_RATE_LIMIT_MUTATE_PER_MIN: ${N4_RATE_LIMIT_MUTATE_PER_MIN:?порог частоты для мутирующих маршрутов не задан}
      N4_RATE_LIMIT_READ_PER_MIN: ${N4_RATE_LIMIT_READ_PER_MIN:?порог частоты для чтения не задан}
    expose: ["3000"]
    networks: [private, egress]
    depends_on:
      db: { condition: service_healthy }
      storage: { condition: service_healthy }
      storage-init: { condition: service_completed_successfully }
    healthcheck:
      # Проба переведена с TCP на HTTP в фиче `foundation`: служебный `GET /health` введён
      # решением по канону (он ВНЕ префикса /api/v1, продуктовых маршрутов по-прежнему 14).
      # Разница содержательна: TCP-проба говорит «процесс слушает», а этот ответ означает,
      # что база отвечает на SELECT 1. При недоступной базе он даёт 503, и сервис перестаёт
      # быть healthy — недоступность источника истины обязана быть видна, а не подразумеваться.
      test: ["CMD", "node", "-e", "require('http').get('http://127.0.0.1:3000/health',function(r){process.exit(r.statusCode===200?0:1)}).on('error',function(){process.exit(1)})"]
      interval: 5s
      timeout: 3s
      retries: 20

  # ─── Воркер распознавания: единственный сервис, у которого есть чем позвать модель ───
  recognizer:
    build:
      context: .
      target: recognizer
    profiles: [app, dev, edge]
    restart: unless-stopped
    environment:
      NODE_ENV: production
      TZ: Europe/Moscow
      DATABASE_URL: postgresql://n4_app:${N4_DB_APP_PASSWORD:?задайте пароль роли приложения}@db:5432/n4
      S3_ENDPOINT: http://storage:9000
      S3_BUCKET: ${N4_S3_BUCKET:-n4-photos}
      S3_ACCESS_KEY: ${N4_S3_ACCESS_KEY:?задайте ключ доступа приложения к бакету}
      S3_SECRET_KEY: ${N4_S3_SECRET_KEY:?задайте секрет доступа приложения к бакету}
      # Выбор реализации адаптера. Закрытый набор значений принадлежит КОДУ (fake | live),
      # переменная только выбирает. Безопасное значение по умолчанию — fake: оно не тратит денег.
      N4_MODEL_PROVIDER: ${N4_MODEL_PROVIDER:-fake}
      # Ключа на этой машине нет (DEC-A-009). Пустое значение законно при N4_MODEL_PROVIDER=fake
      # и ОБЯЗАНО валить старт при live — проверку делает код, потому что условие зависит от режима.
      ANTHROPIC_API_KEY: ${ANTHROPIC_API_KEY:-}
      N4_SCAN_LIMIT_USER: ${N4_SCAN_LIMIT_USER:?потолок на пользователя не задан}
      N4_SCAN_LIMIT_DAY: ${N4_SCAN_LIMIT_DAY:?суточный потолок попыток не задан}
      N4_ESCALATION_LIMIT_DAY: ${N4_ESCALATION_LIMIT_DAY:?суточный потолок эскалаций не задан}
    networks: [private, egress]
    depends_on:
      db: { condition: service_healthy }
      storage: { condition: service_healthy }
      storage-init: { condition: service_completed_successfully }
    # healthcheck не объявлен осознанно: от recognizer не зависит ни один сервис, а проверка
    # «процесс жив» повторила бы restart: unless-stopped. Молчащий воркер ловится метрикой
    # «возраст старейшего задания queued > 60 с» (Completion.md, Monitoring), а не healthcheck'ом.

  # ─── Один фронт на PWA и Telegram Mini App. Секретов вызова наружу не имеет — это проверяемо ───
  web:
    build:
      context: .
      target: web
    profiles: [app, dev, edge]
    restart: unless-stopped
    environment:
      NODE_ENV: production
      TZ: Europe/Moscow
      APP_ORIGIN: ${APP_ORIGIN:?внешний адрес обязателен}
      API_INTERNAL_URL: http://api:3000
      NEXT_TELEMETRY_DISABLED: "1"
    # ХОСТОВОГО ПОРТА У web НЕТ, и это не забывчивость. Черновик публиковал
    # 127.0.0.1:${N4_WEB_PORT:-4184}:3000 «для прямой отладки»; проверка
    # `bash ../../scripts/check-port-conflicts.sh .` вернула 1 и назвала причину: web,
    # опубликованный рядом с proxy, позволяет обойти прокси ВМЕСТЕ СО ВСЕМ, что прокси
    # гарантирует. Здесь это не абстракция: Caddy держит ограничение частоты, работающее
    # ДО валидации тела (`security-operation-order`), и прямой путь к web снимает его.
    # Единственная дверь — профиль `edge` на 127.0.0.1:${N4_EDGE_PORT:-4180}.
    expose: ["3000"]
    networks: [private, egress]
    depends_on:
      api: { condition: service_healthy }
    healthcheck:
      test: ["CMD", "node", "-e", "require('net').connect(3000,'127.0.0.1').on('connect',function(){process.exit(0)}).on('error',function(){process.exit(1)})"]
      interval: 5s

hook: PreToolUse
