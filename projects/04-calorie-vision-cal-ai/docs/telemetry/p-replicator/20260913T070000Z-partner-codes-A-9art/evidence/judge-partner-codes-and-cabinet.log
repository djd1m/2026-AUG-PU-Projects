  it('отказ называет ВСЕ незакрытые переменные сразу, а не первую', () => {
    const error = refusalFor(() => loadApiConfig({ ...FULL_API_ENV, N4_SCAN_LIMIT_USER: '', APP_ORIGIN: '' }));
