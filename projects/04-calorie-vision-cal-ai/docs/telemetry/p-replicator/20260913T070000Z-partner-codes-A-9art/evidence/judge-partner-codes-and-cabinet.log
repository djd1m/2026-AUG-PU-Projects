    expect(refusalFor(() => loadApiConfig(withoutVariable(FULL_API_ENV, 'TELEGRAM_BOT_TOKEN'))).variables).toEqual(['TELEGRAM_BOT_TOKEN']);
    for (const bad of ['not-a-real-token', '123456789', '123456789:short', '']) {
