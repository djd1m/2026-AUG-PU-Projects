  });

  it('AC-6: прямой запрос с пустым контактом получает 422 в обход клиента, строка не создаётся', async () => {
    const token = await newSessionCookie('203.0.113.40');

    const response = await app.inject({
      method: 'POST',
      url: '/api/v1/interest',
