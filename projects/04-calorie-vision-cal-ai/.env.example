# N4 «Тарелка» — имена переменных и безопасные примеры. ЗНАЧЕНИЯ сюда не пишутся никогда:
# файл лежит в git, а .env — нет. Секреты создаются заново для каждого окружения.
#
# ХОСТОВЫЕ ПОРТЫ ПРАВЯТСЯ ПОД МАШИНУ. На этой машине заняты 80, 443, 3002, 5480, 8080, 8081,
# 8088, 11000, 11001, 11432, 13030–13034 и другие; 80 и 443 держит чужой reverse-proxy, и из
# проекта они не публикуются вовсе. Перед первым `up`:
#   bash ../../scripts/check-port-conflicts.sh .

# ─── Хостовые порты и имя стека: единственные переменные с дефолтом ────────────────────────
N4_COMPOSE_PROJECT=n4-tarelka
# Единственный публикуемый порт стека — дверь Caddy (профиль edge), только на петлю.
N4_EDGE_PORT=4180
# N4_WEB_PORT намеренно отсутствует: web хостового порта НЕ публикует. Публикация рядом с
# proxy даёт обойти прокси вместе с ограничением частоты, которое он держит; проверка
# scripts/check-port-conflicts.sh возвращает на это 1. Прямой доступ к web — только разовым
# `docker compose run --service-ports`, и такая правка в compose не коммитится.

# ─── Внешний адрес. Дефолта НЕТ намеренно: он определяет каждую выдаваемую наружу ссылку,
#     и тихий http://localhost сделал бы их все нерабочими при полностью зелёных тестах ─────
APP_ORIGIN=

# ─── База данных. Порт на хост не публикуется; соседи ходят по имени db:5432 ───────────────
N4_DB_ADMIN_PASSWORD=
N4_DB_APP_PASSWORD=

# ─── Приватный бакет фото. Пара minioadmin/minioadmin запрещена: это не «временно для
#     тестов», а готовая точка входа ────────────────────────────────────────────────────────
N4_STORAGE_ROOT_USER=
N4_STORAGE_ROOT_PASSWORD=
N4_S3_BUCKET=n4-photos
N4_S3_ACCESS_KEY=
N4_S3_SECRET_KEY=

# ─── Telegram. Токен бота нужен ТОЛЬКО api: из него производится секрет HMAC для initData ──
TELEGRAM_BOT_TOKEN=

# ─── Потолки вызовов модели. ТРИ числа, каждое обязательно. Пустое значение не означает
#     «без ограничений» — оно валит старт процесса с названным незакрытым вызовом (ADR-007).
#     Значения канона: 10 на пользователя в сутки, 3000 попыток системы, 600 эскалаций ──────
N4_SCAN_LIMIT_USER=10
N4_SCAN_LIMIT_DAY=3000
N4_ESCALATION_LIMIT_DAY=600

# ─── Поставщик модели. Закрытый набор значений принадлежит КОДУ: fake | live.
#     fake — детерминированный адаптер, денег не тратит и наружу не ходит; им работают тесты
#     и стенд. live требует ключа и обязан валить старт без него.
#     Ключа на этой машине нет (DEC-A-009): прогон без него живым смоуком не объявляется ────
N4_MODEL_PROVIDER=fake
ANTHROPIC_API_KEY=

# Порог эскалации 0,6, модели Haiku 4.5 и Sonnet 5, таймзона Europe/Moscow — ЧИСЛА КАНОНА
# (docs/canon.md §7, ADR-004), а не настройки окружения: переменной для них нет намеренно.
