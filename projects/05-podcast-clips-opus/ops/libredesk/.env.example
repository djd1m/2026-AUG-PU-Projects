# Copy to a root-only PRIVATE directory, mode 0600; never commit generated values.
# Set immutable IDs only after local inspection; no implicit pull is authorized.
N5_HELPDESK_PROXY_IMAGE=
N5_HELPDESK_PG_IMAGE=postgres:16.4-alpine
N5_HELPDESK_REDIS_IMAGE=redis:7.4-alpine
N5_HELPDESK_CONFIG_PATH=
N5_HELPDESK_PORT=4191
N5_HELPDESK_DB_PASSWORD=
N5_HELPDESK_REDIS_PASSWORD=
# Used only by the explicit one-shot bootstrap, never passed to normal app startup.
LIBREDESK_SYSTEM_USER_PASSWORD=
