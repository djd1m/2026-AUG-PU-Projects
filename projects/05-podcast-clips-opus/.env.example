# N5 «КлипМейкер» — переменные окружения. Значения ниже — ПРИМЕРЫ; секреты создаются заново для
# каждого окружения и в git не попадают (.gitignore). Потолки и origin дефолтов НЕ имеют: их
# отсутствие валит запуск (silent-fallbacks.md, canon §6–7).

# ── хостовые порты (правятся под машину, port-conflicts-local.md) ──
N5_COMPOSE_PROJECT=n5-clipmaker
N5_EDGE_PORT=4181

# ── публичный origin: вшивается в метку каждого клипа, дефолта нет ──
N5_PUBLIC_ORIGIN=https://clipmaker.example.ru

# ── база и очередь ──
N5_DB_APP_PASSWORD=
REDIS_PASSWORD=
SESSION_SECRET=

# ── потолки (канон §7; ненастроенный потолок валит запуск) ──
N5_LIMIT_USER_MINUTES=90
N5_LIMIT_USER_UPLOADS=2
N5_LIMIT_USER_UPLOAD_REFUNDS=2
N5_LIMIT_USER_LLM=2
N5_LIMIT_GLOBAL_MINUTES=600
N5_LIMIT_GLOBAL_LLM=20

# ── хранилище: боевой профиль — Cloud.ru Object Storage (OWN-004) ──
S3_ENDPOINT=https://s3.cloud.ru
S3_REGION=ru-central-1
S3_BUCKET=n5-clipmaker
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false

# ── модели: ключ STT только у worker-stt, ключ LLM только у worker-llm ──
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── тестовый профиль (MinIO без публикации портов) ──
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
