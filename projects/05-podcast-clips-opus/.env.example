# N5 «КлипМейкер» — переменные окружения. Значения ниже — ПРИМЕРЫ; секреты создаются заново для
# каждого окружения и в git не попадают (.gitignore). Потолки и origin дефолтов НЕ имеют: их
# отсутствие валит запуск (silent-fallbacks.md, canon §6–7).
# Полное пошаговое описание каждой переменной — docs/REPRODUCE.md, шаг 3.
# Секреты генерировать так: openssl rand -hex 24  (SESSION_SECRET — не короче 32 байт).

# ── хостовые порты (правятся под машину, port-conflicts-local.md) ──
N5_COMPOSE_PROJECT=n5-clipmaker
N5_EDGE_PORT=4181
# Число доверенных адресов СПРАВА в XFF, после клиента; недостаточная цепочка отвергается.
# Свой Caddy + внешний TLS-прокси = 2; только свой Caddy с TLS = 1.
N5_TRUSTED_PROXY_HOPS=2

# ── публичный origin: вшивается в метку каждого клипа, дефолта нет ──
N5_PUBLIC_ORIGIN=https://clipmkr.ru
# SL-001: новые коды из 6 символов; старые коды из 10 символов сохраняются.
N5_SHORT_CODE_LENGTH=6

# ── аналитика: подключается при запуске в Cloud.ru РФ, только у web ──
# Публичный ID собственного счётчика Яндекс Метрики, не пароль/токен.
# Пусто или невалидно — SDK и отправка выключены. Требуется согласие пользователя.
# Цели и проверка поступления: docs/features/acquisition-analytics/cloudru-launch.md
N5_METRIKA_COUNTER_ID=

# ── база и очередь ──
N5_DB_APP_PASSWORD=
REDIS_PASSWORD=
SESSION_SECRET=

# ── потолки (канон §7; ненастроенный потолок валит запуск) ──
N5_LIMIT_USER_RERENDERS=20
N5_LIMIT_USER_MINUTES=90
# Тариф paid (OWN-019): 270 = три записи по 90 мин; не больше N5_LIMIT_GLOBAL_MINUTES, иначе отказ старта.
N5_LIMIT_PAID_USER_MINUTES=270
N5_LIMIT_USER_UPLOADS=2
N5_LIMIT_USER_UPLOAD_REFUNDS=2
N5_LIMIT_USER_LLM=2
N5_LIMIT_GLOBAL_MINUTES=600
N5_LIMIT_GLOBAL_LLM=20

# ── оплата ЮKassa (фича 30, ADR-019) ──
# Не задана → off: «снять метку» ведёт на экран интереса. fake — только тесты/разработка (в production отказ старта).
# live — включает владелец скриптом scripts/stand-set-yookassa.sh; адрес уведомлений:
#   ${N5_PUBLIC_ORIGIN}/api/webhooks/yookassa (https://clipmkr.ru/api/webhooks/yookassa), события payment.succeeded, refund.succeeded.
# N5_PAYMENTS_MODE=off
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
# YOOKASSA_TEST_MODE=true

# ── хранилище: боевой профиль — Cloud.ru Object Storage (OWN-004) ──
S3_ENDPOINT=https://s3.cloud.ru
# Обязательный HTTPS origin для подписи ссылок браузеру (только web).
# В Cloud.ru совпадает с S3_ENDPOINT. Для MinIO укажите внешний HTTPS origin,
# доступный браузеру; прокси должен сохранить подписанный Host. Дефолта нет.
S3_PUBLIC_ENDPOINT=https://s3.cloud.ru
S3_REGION=ru-central-1
S3_BUCKET=n5-clipmaker
# Cloud.ru: S3_ENDPOINT и S3_PUBLIC_ENDPOINT=https://s3.cloud.ru, S3_REGION=ru-central-1;
# S3_ACCESS_KEY=<tenant_id>:<key_id>, S3_SECRET_KEY=Key Secret (не FM-ключ).
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false

# ── модели: ключ нужен только выбранному live-поставщику ──
# STT: openrouter (default) или yandex; Cloud.ru STT отказывает без таймкодов слов.
N5_STT_PROVIDER=openrouter
N5_LLM_PROVIDER=openrouter
# Только worker-llm. Для cloudru также N5_LLM_MODEL=deepseek-ai/DeepSeek-V4-Pro.
CLOUDRU_FM_API_KEY=
OPENROUTER_API_KEY=
# Только worker-stt; для N5_STT_PROVIDER=yandex (фиксированный SpeechKit v3 general).
YANDEX_SPEECHKIT_API_KEY=
N5_LLM_MODEL=anthropic/claude-sonnet-5
# Претендент для сравнения на том же транскрипте: google/gemini-3.8-flash

# ── субтитры: словарь терминов, необязательно (пусто = встроенный) ──
# Формат: услышано=правильно;услышано=правильно. Меняет ТОЛЬКО показ в субтитрах.
N5_GLOSSARY=

# ── тестовый профиль (MinIO без публикации портов) ──
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# New credit enrollments/sales only; persisted policies remain authoritative. Default legacy.
# N5_BILLING_MODE=legacy

# Support access: disabled by default; resend requires API key and explicit sender.
N5_MAIL_MODE=disabled
N5_RESEND_API_KEY=
N5_MAIL_FROM=
N5_SMTP_HOST=
N5_SMTP_PORT=
N5_SMTP_USER=
N5_SMTP_PASSWORD=
N5_SMTP_SECURE=
N5_SUPPORT_MODE=disabled
N5_SUPPORT_BASE_URL=
N5_SUPPORT_INBOX_ID=
N5_SUPPORT_IDENTIFIED=false
N5_SUPPORT_JWT_SECRET=
N5_SUPPORT_CONTACT_EMAIL=
# Only NODE_ENV=test; private /tmp capture file, never a public mailbox endpoint.
N5_MAIL_TEST_CAPTURE_FILE=
