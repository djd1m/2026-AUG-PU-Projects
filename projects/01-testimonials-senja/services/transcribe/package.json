{
  "name": "@proofwall/transcribe",
  "version": "0.2.0",
  "private": true,
  "description": "Единственная точка входа к внешнему STT-провайдеру (OpenAI). ADR-005: сервис не принимает текст отзыва на вход — только видео/аудио, выход — расшифровка.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "express": "^5.2.0",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.23.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
