# Скопировать в .env и заполнить. .env в git НЕ коммитится.

# --- Postgres (сервис compose, не managed) ---
POSTGRES_DB=proofwall
POSTGRES_USER=proofwall
POSTGRES_PASSWORD=            # НЕ оставлять дефолтным: открытая БД с паролем postgres
                              # уже приводила к компрометации VPS майнером
DATABASE_URL=postgres://proofwall:@postgres:5432/proofwall

# --- Объектное хранилище (MinIO, S3-совместимое) ---
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
S3_ENDPOINT=http://minio:9000
S3_BUCKET=testimonial-videos
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Сессии владельцев ---
SESSION_SECRET=               # длинная случайная строка

# --- Платежи (FR-008, FR-GROWTH-002) ---

                              # [GAP: выбор платёжного провайдера]

# --- OpenAI STT (только для services/transcribe, D-007/ADR-005) ---
OPENAI_API_KEY=                    # web и worker его не получают — ADR-005
OPENAI_TRANSCRIBE_MODEL=           # опционально; дефолт gpt-4o-mini-transcribe (research/openai-footprint/01-speech.md §8)

# --- Caddy / TLS ---
# Внешний адрес приложения. От него строится КАЖДАЯ выдаваемая наружу ссылка:
# форма сбора, витрина, сниппет виджета, href badge. Без него всё указывает на
# http://localhost:3000, то есть на машину посетителя. Проверить после развёртывания:
# bash scripts/check-cjm.sh https://<ваш-домен>
BASE_URL=https://proofwall.example.com
APP_DOMAIN=proofwall.example
ACME_EMAIL=

# --- Хостовые порты (см. .claude/rules/docker-ports.md) ---------------------
# Правятся ПОД МАШИНУ, а не в docker-compose.yml. Перед `docker compose up`
# прогнать: bash ../../scripts/check-port-conflicts.sh .
# Конфликтует только левая (хостовая) часть — номер внутри контейнера менять не нужно.
WEB_PORT=3000
HTTP_PORT=80
HTTPS_PORT=443

# --- Оплата: ЮKassa (decisions/D-009) --------------------------------------
# Провайдер НЕ подписывает уведомления. Подлинность подтверждается двумя способами
# сразу: адрес источника из опубликованного списка сетей ЮKassa + перезапрос статуса
# платежа через API. Секрета для проверки подписи здесь нет и не должно быть.
#
# PAYMENTS_STUB=true — платежи симулируются, к ЮKassa обращений не происходит.
# Так же устроен 2026-APR-PU-LESSON-06. Для локальной разработки оставить true.
PAYMENTS_STUB=true
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Цена платного тарифа в рублях. [GAP: не зафиксирована в PRD/Specification]
PAID_TIER_PRICE_RUB=990
