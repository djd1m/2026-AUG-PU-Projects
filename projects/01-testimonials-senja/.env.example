# Скопировать в .env и заполнить. .env в git НЕ коммитится.

# --- Postgres (сервис compose, не managed) ---
POSTGRES_DB=proofwall
POSTGRES_USER=proofwall
POSTGRES_PASSWORD=            # НЕ оставлять дефолтным: открытая БД с паролем postgres
                              # уже приводила к компрометации VPS майнером
DATABASE_URL=postgres://proofwall:@postgres:5432/proofwall

# --- Объектное хранилище (MinIO, S3-совместимое) ---
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
S3_ENDPOINT=http://minio:9000
S3_BUCKET=testimonial-videos
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Сессии владельцев ---
SESSION_SECRET=               # длинная случайная строка

# --- Платежи (FR-008, FR-GROWTH-002) ---
PAYMENT_WEBHOOK_SECRET=       # HMAC входящих вебхуков; проверяется ДО идемпотентности
                              # [GAP: выбор платёжного провайдера]

# --- Claude (только для mcp-claude) ---
ANTHROPIC_API_KEY=            # web и worker его не получают — ADR-005

# --- Caddy / TLS ---
APP_DOMAIN=proofwall.example
ACME_EMAIL=
