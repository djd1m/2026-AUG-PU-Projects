# TLS-терминация и раздача виджета — ADR-007.
#
# Без HTTPS badge loop физически не работает: виджет грузится на чужие
# HTTPS-сайты, и скрипт по HTTP браузер блокирует как mixed content — молча.
{
	email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
	encode gzip zstd

	# Виджет версионируется по content-hash в имени файла (ADR-007),
	# поэтому кэшируется агрессивно — новая версия = новое имя.
	@widget path /widget.*.js
	header @widget Cache-Control "public, max-age=31536000, immutable"

	# CORS для /api/widget/* здесь НЕ ставится — его выставляет само приложение
	# (apps/web/src/app/api/widget/config/route.ts), и оно же знает, каким роутам он
	# нужен. Два экземпляра Access-Control-Allow-Origin ломают запрос ЦЕЛИКОМ: браузер
	# отвергает ответ, и виджет не грузится ни на одном чужом сайте.
	#
	# Дефект коварен тем, что curl показывает оба заголовка и выглядит нормально —
	# видно его только в браузере, на кросс-доменном запросе. Найден на живом стенде.

	reverse_proxy web:3000
}
