{
  "name": "@proofwall/web",
  "private": true,
  "version": "0.1.0",
  "description": "Next.js-монолит Proofwall: дашборд, форма сбора /f/<slug>, стена /w/<slug>, API-роуты, аутентификация владельцев (Architecture §2, §3.2).",
  "scripts": {
