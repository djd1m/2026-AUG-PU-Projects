# Supply fresh distinct secrets outside git. Never copy a donor environment.
N3A_COMPOSE_PROJECT=
N3A_DB_ADMIN_PASSWORD=
N3A_DB_APP_PASSWORD=
N3A_DB_MIGRATE_PASSWORD=
# Canonical base64url, at least 32 random decoded bytes.
SESSION_SECRET=
# Stable independent identity/admission keys: do not rotate with the session key.
IDENTITY_SECRET=
ADMISSION_SECRET=
# Exact HTTPS origin; http://localhost is restricted to tested local browser use.
APP_ORIGIN=
N3A_WEB_PORT=
# For an explicitly configured standalone process only:
DATABASE_URL=
DATABASE_URL_MIGRATE=
