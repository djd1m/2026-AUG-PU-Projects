# N6b — ТОЛЬКО ИМЕНА переменных. Значения задаются в .env на машине (.env не коммитится).
# Пустое значение = не задано: compose (`${VAR:?}`) и Boot config check откажут со старта — так задумано.
# Ключ OpenRouter берётся из N6 по разрешению владельца (OWN-06B-007) и нигде не выводится.

# ── Секреты ──
OPENROUTER_API_KEY=
SESSION_SECRET=
VISITOR_SECRET=
POSTGRES_PASSWORD=
N6B_DB_TENANT_PASSWORD=
N6B_DB_SERVICE_PASSWORD=

# ── Внешний адрес и сеть прокси (на стенде: https://n6b.194.85.249.105.sslip.io и talk-ai-public, OWN-06B-006) ──
PUBLIC_BASE_URL=
PROXY_NETWORK=

# ── Граница «не знаю» (начальное значение порога — в docs/Refinement.md, до калибровки SC-US-006-4) ──
MIN_SIMILARITY=

# ── Потолки расходов (числа — docs/model-cost-contract.md, OWN-06B-004) ──
LIMIT_ANSWER_VISITOR_DAY=
LIMIT_ANSWER_BOT_DAY=
LIMIT_ANSWER_GLOBAL_DAY=
LIMIT_SANDBOX_ACCOUNT_DAY=
LIMIT_SANDBOX_GLOBAL_DAY=
LIMIT_EMBED_TOKENS_ACCOUNT_DAY=
LIMIT_EMBED_TOKENS_GLOBAL_DAY=
LIMIT_AUTH_ADDR_HOUR=

# ── Машина: правятся под занятость портов (bash ../../scripts/check-port-conflicts.sh), в compose — только ${VAR:-default} ──
N6B_WEB_PORT=

# ── Теги образов для отката (docs/Completion.md → Rollback) ──
N6B_WEB_TAG=
N6B_WORKER_TAG=
N6B_MIGRATE_TAG=

# ── Тестовый стек (compose.test.yml, `name: n6b-test`; пароли без значений по умолчанию — openssl rand -hex 24) ──
TEST_DB_PASSWORD=
TEST_TENANT_PASSWORD=
TEST_SERVICE_PASSWORD=
