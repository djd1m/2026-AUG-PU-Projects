# Скопировать в .env и заполнить. .env НЕ коммитится.

POSTGRES_USER=reviewqr
POSTGRES_PASSWORD=          # openssl rand -hex 24
POSTGRES_DB=reviewqr

# ЧЕТЫРЕ РОЛИ, ПО ОДНОЙ НА КОНТЕЙНЕР. Разные строки подключения — не удобство, а защита:
# пул можно перепутать в коде, а DATABASE_URL, которого в контейнере НЕТ, — нельзя.
DATABASE_URL_RENDER=postgres://app_render:PASS@postgres:5432/reviewqr
DATABASE_URL_INTAKE=postgres://app_intake:PASS@postgres:5432/reviewqr
DATABASE_URL_NOTIFY=postgres://app_notify:PASS@postgres:5432/reviewqr
DATABASE_URL_OWNER=postgres://app_owner:PASS@postgres:5432/reviewqr

PGPOOL_MAX=10
PGPOOL_CONNECTION_TIMEOUT_MS=2000

# Внешний адрес. БЕЗ ДЕФОЛТА в проде: он определяет каждую выданную наружу ссылку и
# каждый QR-код. Урок проекта 01 — тихий дефолт отправил все ссылки на localhost.
BASE_URL=

SESSION_SECRET=             # >= 16 символов

# Хостовые порты — правятся под машину, в compose числом не пишутся
HTTP_PORT=3100
HTTPS_PORT=3101

TELEGRAM_BOT_TOKEN=
MAX_BOT_TOKEN=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Цена плана «Точка», ₽ за 30 дней. Не задана — 990 (решение DEC-PAY-1, 2026-09-02).
PRICE_POINT_RUB=
