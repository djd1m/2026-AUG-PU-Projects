{
  "name": "reviewqr",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "test": "bash scripts/test-all.sh",
    "test:one": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "guards": "bash scripts/check-db-grants.sh",
    "migrate": "tsx packages/db/src/migrate.ts"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "pg": "^8.13.1",
    "qrcode": "^1.5.4"
  }
}
