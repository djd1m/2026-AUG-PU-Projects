# N6 «Суфлёр» — шаблон .env машины. Скопировать в .env, права 600, в git не коммитить.
# Секреты ПУСТЫЕ намеренно: compose валит `config`, пока они не заданы (${VAR:?}).
# Генерация: openssl rand -hex 24 (пароли), openssl rand -hex 32 (SESSION_SECRET).

# ── правится под машину ──
N6_COMPOSE_PROJECT=n6-sufler
# хостовый порт двери (только петля); проверить: bash ../../scripts/check-port-conflicts.sh projects/06-rag-sales-chatbase
N6_HTTP_PORT=8086
IMAGE_TAG=dev

# ── секреты (пусто = отказ старта) ──
N6_DB_PASSWORD=
REDIS_PASSWORD=
SESSION_SECRET=
# ключ СВОЙ для N6 (A-N6-019 проверил сеть ключом стенда N5); только на сервере
OPENROUTER_API_KEY=

# ── выданный адрес стенда, https:, без завершающего слеша; localhost и пусто — отказ ──
N6_PUBLIC_ORIGIN=

# ── модели (канон §7) ──
ANSWER_MODEL=anthropic/claude-haiku-4.5
EMBED_MODEL=openai/text-embedding-3-small

# ── потолки платных вызовов: 10 scope, 14 переменных (канон §7, A-N6-020) ──
# Изменение — решение владельца, одновременно здесь и в docs/canon.md §7.
QUOTA_VISITOR_ANSWERS=20
QUOTA_IP_ANSWERS=60
QUOTA_BOT_DAY_FREE=50
QUOTA_BOT_DAY_PAID=300
QUOTA_BOT_MONTH_FREE=300
QUOTA_BOT_MONTH_PAID=3000
QUOTA_GLOBAL_ANSWERS=3000
QUOTA_PREVIEW_SESSION_CREATE=1
QUOTA_PREVIEW_SESSION_ANSWERS=10
QUOTA_IP_PREVIEWS=3
QUOTA_GLOBAL_PREVIEWS=200
QUOTA_GLOBAL_PREVIEW_ANSWERS=1000
QUOTA_ACCOUNT_EMBED=2000000
QUOTA_GLOBAL_EMBED=20000000
