# Names/paths only. Generate ephemeral local keys with scripts/local-runtime.sh.
N7_RUNTIME_DIR=/tmp/n7-f02-runtime
N7_WEB_PORT=18702
N7_APP_ORIGIN=http://127.0.0.1:18702
SAFETY_POLICY_VERSION=n7-safety-v1
SESSION_HMAC_KEY_FILE=/run/secrets/session_key
DATABASE_PASSWORD_FILE=/run/secrets/db_password
CREDENTIAL_KEYRING_FILE=/run/secrets/credential_keyring
MAIL_PROVIDER_ALLOWLIST={"smtp.gmail.com":30,"imap.gmail.com":30,"smtp.yandex.ru":30,"imap.yandex.ru":30,"imap.ya.ru":30}
COMPOSE_PROJECT_NAME=n7f02

RECIPIENT_HASH_KEY_FILE=/run/secrets/recipient_hash_key

# Optional live billing: explicitly select docker-compose.live-billing.yml.
# Host paths below mount files; application *_FILE names are container paths.
# Keep blank until the operator provides private files and owner-approved price.
N7_YOOKASSA_SHOP_ID_FILE=
N7_YOOKASSA_SECRET_KEY_FILE=
N7_TEAM_PRICE_MINOR=
# For live billing replace N7_APP_ORIGIN above with the verified HTTPS origin.
# See docs/live-billing-runtime.md for activation gates.
