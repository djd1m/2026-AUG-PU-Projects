{
  "name": "n7-cold-email-warmup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "build": "tsc -p tsconfig.build.json",
    "test": "tsx --test --test-concurrency=1 tests/*-unit.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 tests/*-integration.test.ts",
    "start": "node dist/main.js",
    "migrate": "node dist/migrate.js"
  },
  "dependencies": {
    "@node-rs/argon2": "2.0.2",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "eslint": "9.39.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1"
  }
}
