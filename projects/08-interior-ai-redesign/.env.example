# Placeholders only. Supply secrets privately; never commit .env.
DB_PASSWORD=REPLACE_WITH_RANDOM_HEX_AT_LEAST_24_CHARACTERS
SESSION_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
APP_ORIGIN=http://127.0.0.1:18088
WEB_PORT=18088
COMPOSE_PROJECT_NAME=roomkind-f01-local
NODE_ENV=development
# For direct Node execution:
DATABASE_URL=postgresql://roomkind:REPLACE_WITH_RANDOM_HEX_AT_LEAST_24_CHARACTERS@127.0.0.1:5432/roomkind
STORAGE_DIR=/tmp/roomkind-private
PROVIDER_MODE=disabled
WORKER_MODE=disabled
PORT=18088
HOST=127.0.0.1

# Required conservative attempt-ticket ceilings; lower values only.
PLATFORM_DAILY_LIMIT=200
ACCOUNT_DAILY_LIMIT=20

# Separate worker CLI only; web keeps WORKER_MODE=disabled.
# Explicit controlnet requires offline operator-provisioned MODEL_ROOT/manifest.json.
# WORKER_MODE=controlnet
# MODEL_ROOT=/private-models
# WORKER_SOURCE_REVISION=<immutable-source-snapshot-sha256-or-commit>
# WORKER_SEED=1
# WORKER_PYTHON=/opt/roomkind-worker/bin/python
# fixture is DEVELOPMENT ONLY and never quality/public acceptance evidence.

# Trusted server quality CLI identity and independent measured report, no HTTP setter.
# QUALITY_OPERATOR_ID=<server-configured-operator-identity>
# QUALITY_CORPUS_REPORT=/private-reports/geometry.json
# QUALITY_CORPUS_SHA256=<sha256-of-actual-report-bytes>
