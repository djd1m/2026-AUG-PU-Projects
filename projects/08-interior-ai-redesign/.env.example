# Placeholders only. Supply secrets privately; never commit .env.
DB_PASSWORD=REPLACE_WITH_RANDOM_HEX_AT_LEAST_24_CHARACTERS
SESSION_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
APP_ORIGIN=http://127.0.0.1:18088
WEB_PORT=18088
COMPOSE_PROJECT_NAME=roomkind-f01-local
NODE_ENV=development
# For direct Node execution:
DATABASE_URL=postgresql://roomkind:REPLACE_WITH_RANDOM_HEX_AT_LEAST_24_CHARACTERS@127.0.0.1:5432/roomkind
STORAGE_DIR=/tmp/roomkind-private
PROVIDER_MODE=disabled
WORKER_MODE=disabled
PORT=18088
HOST=127.0.0.1

# Required conservative attempt-ticket ceilings; lower values only.
PLATFORM_DAILY_LIMIT=200
ACCOUNT_DAILY_LIMIT=20

# Separate worker CLI only; web keeps WORKER_MODE=disabled.
# Explicit controlnet requires offline operator-provisioned MODEL_ROOT/manifest.json.
# WORKER_MODE=controlnet
# MODEL_ROOT=/private-models
# WORKER_SOURCE_REVISION=<immutable-source-snapshot-sha256-or-commit>
# WORKER_SEED=1
# WORKER_PYTHON=/opt/roomkind-worker/bin/python
# fixture is DEVELOPMENT ONLY and never quality/public acceptance evidence.

# Trusted server quality CLI identity and independent measured report, no HTTP setter.
# QUALITY_OPERATOR_ID=<server-configured-operator-identity>
# QUALITY_CORPUS_REPORT=/private-reports/geometry.json
# QUALITY_CORPUS_SHA256=<sha256-of-actual-report-bytes>

# Explicit server-only payment modes: disabled (default), fixture (nonproduction), live.
# Live additionally requires separate authorization for external effects.
# YOOKASSA_SHOP_ID=<merchant ID>
# YOOKASSA_SECRET_KEY=<private server secret>
# PROVIDER_MODE=fixture

# Hosted generation: OFF by default. No automatic spend envelope or provider call.
# Separate worker only: WORKER_MODE=replicate, or optional Compose profile with
# REPLICATE_WORKER_MODE=replicate. Token must NEVER enter web/browser environment.
# Exact public pins (no model upgrade or fallback):
# REPLICATE_MODEL=jagilley/controlnet-depth2img
# REPLICATE_VERSION=922c7bb67b87ec32cbc2fd11b1d5f94f0ba4f5519c4dbd02856376444127cc60
# REPLICATE_CONTRACT_SHA=3d94bb6e59e6a90e24a0504abb4c06c055f7619372e2c36313f42de5d86e99bc
REPLICATE_WORKER_MODE=disabled
REPLICATE_CLEANUP_ENABLED=false
# WORKER_SOURCE_REVISION=<40-or-64-lowercase-hex-frozen-source>
# WORKER_SEED=<integer-0-through-2147483647>
# REPLICATE_API_TOKEN=<private-worker-only-token>
# REPLICATE_SPEND_BUDGET_ID=<existing-explicitly-authorized-budget-uuid>
# REPLICATE_AUTHORIZATION_SHA=<64-lowercase-hex-owner-authorization>
# REPLICATE_PRIVACY_ACCEPTANCE_SHA=<64-lowercase-hex-owner-privacy-acceptance>
# REPLICATE_LICENSE_ACCEPTANCE_SHA=<64-lowercase-hex-owner-license-acceptance>
# REPLICATE_SAFETY_ACCEPTANCE_SHA=<64-lowercase-hex-owner-safety-acceptance>
# REPLICATE_BILLING_ACCEPTANCE_SHA=<64-lowercase-hex-owner-billing-acceptance>
# Cleanup is a separate explicit opt-in/profile; requires only exact pins/token
# and common server config, never enables create. Default maintenance stays off.
# Default services total 2 CPU. Each optional service adds 0.25 CPU:
# set WEB_CPUS=0.50 for one, WEB_CPUS=0.25 for both to retain aggregate 2 CPU.
