N8_HTTP_PORT=3088
N8_PUBLIC_ORIGIN=http://127.0.0.1:3088
N8_DB_ADMIN_PASSWORD=
N8_APP_PASSWORD=
N8_MIGRATOR_PASSWORD=
N8_SESSION_SECRET=
DATABASE_URL=
N8_ASSET_DIR=
N8_AI_MODE=manual
N8_PAYMENTS_MODE=off
# Run npm run setup:local to generate private secrets. Compose provides database URL and asset path.
# AI live additionally requires ALL fields below. Prices are integer microUSD per million tokens.
N8_OPENROUTER_API_KEY=
N8_AI_MODEL_ID=
N8_AI_ALLOWED_MODELS=
N8_AI_RATE_INPUT_MICRO_USD_PER_MILLION=
N8_AI_RATE_OUTPUT_MICRO_USD_PER_MILLION=
N8_AI_RATE_VALID_UNTIL=
N8_AI_MAX_TOKENS=
N8_AI_REQUEST_OVERHEAD_TOKENS=
N8_AI_JOB_CAP_MICRO_USD=
N8_AI_ACCOUNT_DAY_CAP_MICRO_USD=
N8_AI_GLOBAL_DAY_CAP_MICRO_USD=
N8_AI_PROVIDER_HARD_LIMIT_VERIFIED=
N8_AI_OPERATOR_ENABLED=
# Verified hard limits on a dedicated daily OpenRouter key are checked remotely before dispatch.
# Payment live requires HTTPS origin, actual merchant, server-secret and approved SKU JSON.
N8_PAYMENT_SHOP_ID=
N8_PAYMENT_SECRET=
N8_PAYMENT_TEST_MODE=
N8_PAYMENT_SKUS_JSON=

# Public proxy exactsocketIP. Empty means no forwarded client trust.
N8_TRUSTED_PROXY_IP=
