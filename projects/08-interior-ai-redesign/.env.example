# Шаблон N8: секретов здесь нет. Реальные значения храните только в приватном .env.
# Новый локальный стенд: npm run setup:local создаёт .env с секретами и правами 600.
# Затем перенесите нужные настройки из этого шаблона в созданный .env.
# При ручном копировании шаблона заполните пустые обязательные секреты самостоятельно.
# На существующем стенде сохраните его пароли БД и session secret; добавляйте нужные строки.
# chmod 600 .env

# --- Web: локальный запуск ---
# В base Compose это порт на хосте; внутри контейнера Compose задаёт 3000 и 0.0.0.0.
N8_HTTP_PORT=3088
N8_BIND_HOST=127.0.0.1
N8_PUBLIC_ORIGIN=http://127.0.0.1:3088
NODE_ENV=production

# --- БД и приватные файлы ---
# Три разных случайных пароля. setup:local генерирует их, существующая БД использует прежние.
N8_DB_ADMIN_PASSWORD=
N8_APP_PASSWORD=
N8_MIGRATOR_PASSWORD=
# Случайный session secret длиной минимум 32 байта.
N8_SESSION_SECRET=
# Compose собирает DATABASE_URL сам из N8_APP_PASSWORD; для прямого Node-запуска заполните URL.
# Формат: postgresql://n8_app:YOUR_URL_ENCODED_PASSWORD@DB_HOST:5432/n8
DATABASE_URL=
# В Compose путь задан явно. Для прямого запуска укажите абсолютный путь на своём хосте.
N8_ASSET_DIR=/app/.runtime/assets
# Необязательное переопределение каталога миграций; путь считается от текущего каталога процесса.
N8_MIGRATIONS_DIR=packages/db/src/migrations

# --- Публичный HTTPS: docker-compose.yml + compose.public.yml ---
# Для другого VPS замените host. Overlay сам задаёт HTTPS origin и доверенный proxy IP.
N8_PUBLIC_HOST=n8.77.83.87.178.sslip.io
N8_PROXY_HTTP_PORT=80
N8_PROXY_HTTPS_PORT=443
N8_PROXY_SUBNET=172.29.8.0/24
N8_PROXY_IP=172.29.8.2
N8_WEB_EDGE_IP=172.29.8.3
# Пусто для прямого соединения. В public overlay устанавливается из N8_PROXY_IP.
N8_TRUSTED_PROXY_IP=

# --- AI: Gemini 4 Argon через OpenRouter ---
# manual = без LLM; demo = локальная демонстрация; live = реальные внешние запросы.
# Для live нужны все AI-поля, действующий ключ, проверенные цены и лимиты.
# Только указанный UUID аккаунта использует денежный бюджет без внутренних кредитов.
# Лимиты стоимости, provider key proof и контроль владения сохраняются.
N8_AI_BUDGET_ONLY_ACCOUNT_ID=
N8_AI_MODE=manual
# Единственный ключ AI-провайдера; отдельный Google API key не используется.
N8_OPENROUTER_API_KEY=
N8_AI_MODEL_ID=google/gemini-4-argon
# Разрешённые model ID через запятую без пробелов. Запасная модель автоматически не выбирается.
N8_AI_ALLOWED_MODELS=google/gemini-4-argon
# Цены: целые microUSD за 1 млн токенов. 1 USD = 1000000 microUSD.
# Заполняются по проверенным текущим тарифам OpenRouter, не по цене GPU или ремонта.
N8_AI_RATE_INPUT_MICRO_USD_PER_MILLION=
N8_AI_RATE_OUTPUT_MICRO_USD_PER_MILLION=
# Будущая дата окончания проверки тарифов в ISO 8601, например YYYY-MM-DDTHH:MM:SSZ.
N8_AI_RATE_VALID_UNTIL=
# Предел вывода приложения: максимум 4096; overhead — консервативный запас для расчёта стоимости.
N8_AI_MAX_TOKENS=4096
N8_AI_REQUEST_OVERHEAD_TOKENS=1024
# Денежные потолки в microUSD: job <= account/day <= global/day.
# Пример единиц: 0.10 USD = 100000; 1 USD = 1000000. Значения бюджета нужно выбрать.
N8_AI_JOB_CAP_MICRO_USD=
N8_AI_ACCOUNT_DAY_CAP_MICRO_USD=
N8_AI_GLOBAL_DAY_CAP_MICRO_USD=
# Период и потолок ключа OpenRouter задаются парой, независимо от дневных лимитов N8.
# Для текущего ключа: 10 USD в неделю = 10000000 microUSD.
# Другой вариант: daily и потолок не выше N8_AI_GLOBAL_DAY_CAP_MICRO_USD.
N8_AI_PROVIDER_LIMIT_RESET=weekly
N8_AI_PROVIDER_CAP_MICRO_USD=10000000
# true только после проверки настроенного периода/потолка ключа в OpenRouter.
# Перед dispatch сервер проверяет reset/cap и остаток ключа. Флаг BYOK для оплаты балансом OpenRouter не требуется.
N8_AI_PROVIDER_HARD_LIMIT_VERIFIED=false
# true включает разрешение оператора на live; одной вставки ключа для включения недостаточно.
N8_AI_OPERATOR_ENABLED=false

# --- Оплата возможностей N8: ЮKassa, отдельно от бюджета ремонта ---
# off = оплаты нет; live требует HTTPS, merchant config и утверждённых серверных SKU.
N8_PAYMENTS_MODE=off
N8_PAYMENT_SHOP_ID=
N8_PAYMENT_SECRET=
N8_PAYMENT_TEST_MODE=true
# JSON-массив SKU: sku, priceMinor (копейки), currency "RUB", credits, unwatermarkedExport.
# Для live нужен непустой список с утверждёнными ценами; это не API key.
N8_PAYMENT_SKUS_JSON=

# --- Необязательные тесты и проверка UI; при обычном запуске не используются ---
# Отдельное тестовое PostgreSQL-подключение; интеграционные тесты требуют TEST_DATABASE_URL.
TEST_DATABASE_URL=
# E2E Compose устанавливает true сам; для прямого запуска внешнего driver нужно явное разрешение.
N8_E2E_PUBLIC=false
N8_E2E_APP_IMAGE=n8-interior-app:local
# Каждый прогон требует новый attempt и свой evidence-каталог; существующий результат не затирается.
N8_E2E_ATTEMPT=
# Путь относительно проекта: docs/telemetry/p-replicator/<RUN_ID>/evidence
N8_E2E_EVIDENCE_DIR=
# Абсолютный путь на хосте к тому же evidence-каталогу.
N8_E2E_HOST_EVIDENCE=
# Фактический image ID проверяемого приложения, например sha256:...
N8_BUILD_REVISION=
# Этот путь предназначен для Dockerfile.e2e, не для установки браузеров на хосте.
PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
